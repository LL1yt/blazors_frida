<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorFridaApp</RootNamespace>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateStaticWebAssetsManifest>true</GenerateStaticWebAssetsManifest>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Blazorise" Version="1.7.4" />
    <PackageReference Include="Blazorise.Bootstrap5" Version="1.7.4" />
    <PackageReference Include="Blazorise.Components" Version="1.7.4" />
    <PackageReference Include="Blazorise.DataGrid" Version="1.7.4" />
    <PackageReference Include="Blazorise.Icons.FontAwesome" Version="1.7.4" />
    <PackageReference Include="Blazorise.LoadingIndicator" Version="1.7.4" />
    <PackageReference Include="Blazorise.RichTextEdit" Version="1.7.4" />
    <PackageReference Include="Blazorise.Sidebar" Version="1.7.4" />
    <PackageReference Include="Blazorise.Snackbar" Version="1.7.4" />
    <PackageReference Include="Blazorise.TreeView" Version="1.7.4" />
    <PackageReference Include="bunit" Version="1.38.5" />
    <PackageReference Include="Grpc.AspNetCore.Server.ClientFactory" Version="2.67.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.2" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="2.1.175" />
    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="Polly" Version="8.2.1" />
    <PackageReference Include="Scrutor" Version="6.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.62.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry" Version="1.11.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.11.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.11.0-beta.1" />
  </ItemGroup>

  <!-- Proto Files -->
  <ItemGroup>
    <Protobuf Include="MemoryScanner\Proto\health.proto" GrpcServices="Client" />
    <Protobuf Include="MemoryScanner\Proto\memory_scanner.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- Content Files -->
  <ItemGroup>
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Python Files -->
  <ItemGroup>
    <Content Include="MemoryScanner\Native\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MemoryScanner\Server\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MemoryScanner\Native\requirements.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MemoryScanner\Proto\**\*.proto">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Database Files -->
  <ItemGroup>
    <None Update="gamememory.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Assembly Attributes -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BlazorFridaApp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Razor Components -->
  <ItemGroup>
    <Content Include="**\*.razor" />
  </ItemGroup>

  <!-- Static Web Assets -->
  <ItemGroup>
    <StaticWebAsset Include="_content/**">
      <SourceType>Package</SourceType>
      <SourceId>Blazorise</SourceId>
      <ContentRoot>$(NuGetPackageRoot)blazorise\1.7.4\staticwebassets\</ContentRoot>
      <BasePath>_content/Blazorise</BasePath>
      <RelativePath>**</RelativePath>
    </StaticWebAsset>
    <StaticWebAsset Include="_content/**">
      <SourceType>Package</SourceType>
      <SourceId>Blazorise.Bootstrap5</SourceId>
      <ContentRoot>$(NuGetPackageRoot)blazorise.bootstrap5\1.7.4\staticwebassets\</ContentRoot>
      <BasePath>_content/Blazorise.Bootstrap5</BasePath>
      <RelativePath>**</RelativePath>
    </StaticWebAsset>
    <StaticWebAsset Include="_content/**">
      <SourceType>Package</SourceType>
      <SourceId>Blazorise.Icons.FontAwesome</SourceId>
      <ContentRoot>$(NuGetPackageRoot)blazorise.icons.fontawesome\1.7.4\staticwebassets\</ContentRoot>
      <BasePath>_content/Blazorise.Icons.FontAwesome</BasePath>
      <RelativePath>**</RelativePath>
    </StaticWebAsset>
  </ItemGroup>
</Project>
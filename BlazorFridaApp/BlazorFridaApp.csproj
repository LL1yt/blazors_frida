<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorFridaApp</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.1" />
    <PackageReference Include="pythonnet" Version="3.0.5" />
    <PackageReference Include="Radzen.Blazor" Version=" 5.9.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <!-- Global Usings and Program -->
  <ItemGroup>
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- Memory Scanner -->
  <ItemGroup>
    <Compile Include="MemoryScanner\**\*.cs" />
    <Content Include="MemoryScanner\**\*.razor" />
  </ItemGroup>

  <!-- Services -->
  <ItemGroup>
    <Compile Include="Services\**\*.cs" />
  </ItemGroup>

  <!-- Components -->
  <ItemGroup>
    <Compile Include="Components\**\*.cs" />
    <Content Include="Components\**\*.razor" />
  </ItemGroup>

  <!-- Persistence -->
  <ItemGroup>
    <Compile Include="Persistence\**\*.cs" />
    <Compile Include="Migrations\**\*.cs" />
  </ItemGroup>

  <!-- Static Web Content -->
  <ItemGroup>
    <Content Include="wwwroot\**\*" />
    <Content Include="appsettings.json" />
    <Content Include="appsettings.Development.json" />
  </ItemGroup>

  <!-- SQLite Database -->
  <ItemGroup>
    <None Update="gamememory.db">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Python Files -->
  <ItemGroup>
    <Content Include="MemoryScanner\Native\**\*.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="MemoryScanner\Native\requirements.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

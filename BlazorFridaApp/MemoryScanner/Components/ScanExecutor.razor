@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using Blazorise
@using Microsoft.AspNetCore.Components.Web
@using BlazorFridaApp.MemoryScanner.Models
@using BlazorFridaApp.MemoryScanner.Services.Interfaces

@inherits MemoryScannerComponentBase
@inject IMemoryScannerService MemoryScanner

<div>
    @if (IsLoading)
    {
        <Progress Striped Animated>
            <ProgressBar Value="100" />
        </Progress>
    }
</div>

@code {
    private List<IntPtr> scanResults = new List<IntPtr>();
    private Dictionary<IntPtr, int> previousValues = new Dictionary<IntPtr, int>();

    [Parameter]
    public int? ProcessId { get; set; }

    [Parameter]
    public ScanType ScanType { get; set; }

    [Parameter]
    public MemoryValueType ValueType { get; set; }

    [Parameter]
    public string PatternHex { get; set; } = "";

    [Parameter]
    public string Mask { get; set; } = "";

    [Parameter]
    public int SearchValue { get; set; }

    [Parameter]
    public bool IsFirstScan { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<List<IntPtr>> OnScanComplete { get; set; }

    [Parameter]
    public EventCallback<bool> OnLoadingChanged { get; set; }

    public bool CanExecuteScan => ProcessId.HasValue && !IsLoading;

    public async Task ExecuteScan(Func<IntPtr, int> getCurrentValue)
    {
        if (getCurrentValue == null)
        {
            Logger.LogWarning("Scan attempted without a value getter function");
            return;
        }

        if (!ProcessId.HasValue)
        {
            Logger.LogWarning("Scan attempted without a selected process");
            return;
        }

        try
        {
            var processId = ProcessId.Value;
            Logger.LogInformation("Starting scan operation:\n" +
                "- Process ID: {ProcessId}\n" +
                "- Scan Type: {ScanType}\n" +
                "- Value Type: {ValueType}\n" +
                "- Is First Scan: {IsFirstScan}\n" +
                "- Pattern: {Pattern}\n" +
                "- Mask: {Mask}\n" +
                "- Search Value: {SearchValue}",
                processId, ScanType, ValueType, IsFirstScan, PatternHex, Mask, SearchValue);
            
            if (OnLoadingChanged.HasDelegate)
            {
                Logger.LogDebug("Setting loading state to true");
                await OnLoadingChanged.InvokeAsync(true);
            }
            
            if (ScanType == ScanType.Pattern)
            {
                await HandlePatternScan(processId);
            }
            else
            {
                await HandleValueScan(getCurrentValue, processId);
            }

            var resultCount = scanResults.Count;
            if (resultCount == 0)
            {
                Logger.LogInformation("Scan completed with no results");
                ShowInfo("Scan Results", "No results found");
            }
            else
            {
                Logger.LogInformation("Scan completed successfully with {Count} results", resultCount);
                ShowSuccess("Scan completed", $"Found {resultCount} {(resultCount == 1 ? "result" : "results")}");
            }

            if (OnScanComplete.HasDelegate)
            {
                Logger.LogDebug("Notifying scan completion with {Count} results", resultCount);
                await OnScanComplete.InvokeAsync(scanResults);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Scan operation failed:\n" +
                "- Process ID: {ProcessId}\n" +
                "- Scan Type: {ScanType}\n" +
                "- Error: {Error}",
                ProcessId, ScanType, ex.Message);
            ShowError("Scan failed", ex.GetBaseException().Message, ex);
            scanResults.Clear();
            previousValues.Clear();
            if (OnScanComplete.HasDelegate)
            {
                Logger.LogDebug("Notifying scan completion with error");
                await OnScanComplete.InvokeAsync(scanResults);
            }
        }
        finally
        {
            if (OnLoadingChanged.HasDelegate)
            {
                Logger.LogDebug("Setting loading state to false");
                await OnLoadingChanged.InvokeAsync(false);
            }
        }
    }

    private async Task HandlePatternScan(int processId)
    {
        Logger.LogInformation("Preparing pattern scan:\n" +
            "- Process ID: {ProcessId}\n" +
            "- Pattern: {Pattern}\n" +
            "- Mask: {Mask}",
            processId, PatternHex, Mask);

        var pattern = PatternHex.Split(' ')
            .Select(b => Convert.ToByte(b, 16))
            .ToArray();
        
        Logger.LogDebug("Converted pattern to byte array, length: {Length}", pattern.Length);
        Logger.LogTrace("Pattern bytes: {Bytes}", string.Join(" ", pattern.Select(b => b.ToString("X2"))));
        
        scanResults = await MemoryScanner.ScanForPattern(processId, pattern, Mask);
        Logger.LogInformation("Pattern scan completed with {Count} results", scanResults.Count);
    }

    private async Task HandleValueScan(Func<IntPtr, int> getCurrentValue, int processId)
    {
        if (IsFirstScan)
        {
            Logger.LogInformation("Starting first value scan:\n" +
                "- Process ID: {ProcessId}\n" +
                "- Scan Type: {ScanType}\n" +
                "- Value Type: {ValueType}\n" +
                "- Search Value: {Value}",
                processId, ScanType, ValueType, SearchValue);

            await HandleFirstScan(processId);
            if (scanResults.Count > 0)
            {
                Logger.LogInformation("Processing initial values for {Count} addresses", scanResults.Count);
                await Task.Run(() => ProcessInitialValues(getCurrentValue));
            }
            else
            {
                Logger.LogWarning("First scan returned no results to process");
            }
        }
        else
        {
            Logger.LogInformation("Starting subsequent value scan:\n" +
                "- Process ID: {ProcessId}\n" +
                "- Scan Type: {ScanType}\n" +
                "- Previous Results: {Count}",
                processId, ScanType, scanResults.Count);
            await Task.Run(() => HandleSubsequentScan(getCurrentValue));
        }
    }

    private async Task HandleFirstScan(int processId)
    {
        Logger.LogInformation("Executing first scan:\n" +
            "- Process ID: {ProcessId}\n" +
            "- Scan Type: {ScanType}\n" +
            "- Value Type: {ValueType}",
            processId, ScanType, ValueType);

        try
        {
            scanResults = ScanType switch
            {
                ScanType.ExactValue => await MemoryScanner.ScanForValue(processId, SearchValue, ValueType),
                ScanType.UnknownInitialValue => await MemoryScanner.GetAllAddresses(processId, ValueType),
                _ => new List<IntPtr>()
            };

            Logger.LogDebug("First scan completed:\n" +
                "- Results Count: {Count}\n" +
                "- Scan Type Used: {UsedScanType}",
                scanResults.Count,
                ScanType == ScanType.ExactValue ? "ExactValue" :
                ScanType == ScanType.UnknownInitialValue ? "UnknownInitialValue" : "Unknown");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "First scan failed:\n" +
                "- Process ID: {ProcessId}\n" +
                "- Error: {Error}",
                processId, ex.Message);
            throw;
        }
    }

    private void ProcessInitialValues(Func<IntPtr, int> getCurrentValue)
    {
        Logger.LogInformation("Processing initial values for {Count} addresses", scanResults.Count);
        var processedCount = 0;
        var errorCount = 0;
        var batchStartTime = DateTime.UtcNow;

        foreach (var address in scanResults)
        {
            try
            {
                previousValues[address] = getCurrentValue(address);
                processedCount++;

                if (processedCount % 1000 == 0)
                {
                    var currentTime = DateTime.UtcNow;
                    var batchDuration = currentTime - batchStartTime;
                    Logger.LogDebug("Processing progress:\n" +
                        "- Processed: {Processed}/{Total}\n" +
                        "- Rate: {Rate:F2} addresses/sec\n" +
                        "- Errors: {Errors}",
                        processedCount,
                        scanResults.Count,
                        1000 / batchDuration.TotalSeconds,
                        errorCount);
                    batchStartTime = currentTime;
                }
            }
            catch (Exception ex)
            {
                errorCount++;
                Logger.LogError(ex, "Failed to read value at address {Address}", address);
                if (errorCount % 100 == 0)
                {
                    Logger.LogError("High error rate detected: {ErrorCount} read errors", errorCount);
                }
            }
        }

        var duration = DateTime.UtcNow - batchStartTime;
        Logger.LogInformation("Initial value processing completed:\n" +
            "- Duration: {Duration:F2}s\n" +
            "- Processed: {Processed}\n" +
            "- Errors: {Errors}\n" +
            "- Success Rate: {SuccessRate:P2}",
            duration.TotalSeconds,
            processedCount,
            errorCount,
            (float)(processedCount - errorCount) / processedCount);
    }

    private async Task HandleSubsequentScan(Func<IntPtr, int> getCurrentValue)
    {
        try
        {
            Logger.LogInformation("Starting subsequent scan:\n" +
                "- Previous Results: {Count}\n" +
                "- Scan Type: {ScanType}",
                scanResults.Count, ScanType);
                
            var startTime = DateTime.UtcNow;
            var newResults = new List<IntPtr>();
            var processedCount = 0;
            var errorCount = 0;
            var matchCount = 0;
            var batchStartTime = DateTime.UtcNow;

            foreach (var address in scanResults)
            {
                try
                {
                    var currentValue = getCurrentValue(address);
                    if (!previousValues.TryGetValue(address, out var previousValue))
                    {
                        Logger.LogWarning("No previous value found for address {Address}", address);
                        continue;
                    }
                    processedCount++;

                    bool keepResult = ScanType switch
                    {
                        ScanType.ExactValue => currentValue == SearchValue,
                        ScanType.IncreasedValue => currentValue > previousValue,
                        ScanType.DecreasedValue => currentValue < previousValue,
                        ScanType.ChangedValue => currentValue != previousValue,
                        ScanType.UnchangedValue => currentValue == previousValue,
                        _ => false
                    };

                    if (keepResult)
                    {
                        matchCount++;
                        newResults.Add(address);
                        previousValues[address] = currentValue;
                    }

                    if (processedCount % 1000 == 0)
                    {
                        var currentTime = DateTime.UtcNow;
                        var batchDuration = currentTime - batchStartTime;
                        Logger.LogDebug("Scan progress:\n" +
                            "- Processed: {Processed}/{Total}\n" +
                            "- Matches: {Matches}\n" +
                            "- Rate: {Rate:F2} addresses/sec\n" +
                            "- Errors: {Errors}",
                            processedCount,
                            scanResults.Count,
                            matchCount,
                            1000 / batchDuration.TotalSeconds,
                            errorCount);
                        batchStartTime = currentTime;
                    }
                }
                catch (Exception ex)
                {
                    errorCount++;
                    Logger.LogError(ex, "Failed to process address {Address}", address);
                    if (errorCount % 100 == 0)
                    {
                        Logger.LogError("High error rate detected: {ErrorCount} processing errors", errorCount);
                    }
                }
            }

            var duration = DateTime.UtcNow - startTime;
            Logger.LogInformation("Subsequent scan completed:\n" +
                "- Duration: {Duration:F2}s\n" +
                "- Processed: {Processed}\n" +
                "- Matches: {Matches}\n" +
                "- Errors: {Errors}\n" +
                "- Success Rate: {SuccessRate:P2}",
                duration.TotalSeconds,
                processedCount,
                matchCount,
                errorCount,
                (float)(processedCount - errorCount) / processedCount);

            scanResults = newResults;
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Subsequent scan failed");
            throw;
        }
    }

    public void Reset()
    {
        scanResults.Clear();
        previousValues.Clear();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            Reset();
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during disposal of ScanExecutor");
        }
    }
}
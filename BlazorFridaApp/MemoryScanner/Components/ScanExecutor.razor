@inherits MemoryScannerComponentBase
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Web

@inject IMemoryScannerService MemoryScanner

<div>
    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" Mode="ProgressBarMode.Indeterminate" />
    }
</div>

@code {
    private Dictionary<IntPtr, int> previousValues = new();
    private List<IntPtr> scanResults = new();

    [Parameter]
    public int? ProcessId { get; set; }

    [Parameter]
    public ScanType ScanType { get; set; }

    [Parameter]
    public MemoryValueType ValueType { get; set; }

    [Parameter]
    public string PatternHex { get; set; } = "";

    [Parameter]
    public string Mask { get; set; } = "";

    [Parameter]
    public int SearchValue { get; set; }

    [Parameter]
    public bool IsFirstScan { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback<List<IntPtr>> OnScanComplete { get; set; }

    [Parameter]
    public EventCallback<bool> OnLoadingChanged { get; set; }

    public bool CanExecuteScan => ProcessId.HasValue && !IsLoading;

    protected override void OnInitialized()
    {
        Logger.LogInformation("ScanExecutor component initialized");
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        Logger.LogDebug("ScanExecutor parameters updated: ProcessId: {ProcessId}, ScanType: {ScanType}, ValueType: {ValueType}, IsFirstScan: {IsFirstScan}",
            ProcessId, ScanType, ValueType, IsFirstScan);
        base.OnParametersSet();
    }

    public async Task ExecuteScan(Func<IntPtr, int> getCurrentValue)
    {
        if (!ProcessId.HasValue)
        {
            Logger.LogWarning("Scan attempted without a selected process");
            return;
        }

        try
        {
            var processId = ProcessId.Value; // Cache the value to avoid multiple .Value calls
            Logger.LogInformation("Starting {ScanType} scan for process {ProcessId}. IsFirstScan: {IsFirstScan}, ValueType: {ValueType}",
                ScanType, processId, IsFirstScan, ValueType);
            await OnLoadingChanged.InvokeAsync(true);

            if (ScanType == ScanType.Pattern)
            {
                await HandlePatternScan(processId);
            }
            else
            {
                await HandleValueScan(getCurrentValue, processId);
            }

            var resultCount = scanResults.Count;
            if (resultCount == 0)
            {
                ShowInfo("Scan Results", "No results found");
            }
            else
            {
                ShowSuccess("Scan completed", $"Found {resultCount} {(resultCount == 1 ? "result" : "results")}");
            }
            Logger.LogInformation($"Scan completed. Found {resultCount} results");
            await OnScanComplete.InvokeAsync(scanResults);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during memory scan. ProcessId: {ProcessId}, ScanType: {ScanType}", ProcessId, ScanType);
            ShowError("Scan failed", ex.GetBaseException().Message, ex);
            scanResults.Clear();
            previousValues.Clear();
            await OnScanComplete.InvokeAsync(scanResults);
        }
        finally
        {
            await OnLoadingChanged.InvokeAsync(false);
        }
    }

    private async Task HandlePatternScan(int processId)
    {
        Logger.LogDebug("Preparing pattern scan with hex: {PatternHex}, mask: {Mask}", PatternHex, Mask);
        var pattern = PatternHex.Split(' ')
            .Select(b => Convert.ToByte(b, 16))
            .ToArray();
        Logger.LogTrace("Converted pattern to byte array, length: {Length}", pattern.Length);

        Logger.LogInformation("Executing pattern scan for process {ProcessId}", processId);
        scanResults = await MemoryScanner.ScanForPattern(
            processId,
            pattern,
            Mask);
        Logger.LogDebug("Pattern scan completed with {Count} results", scanResults.Count);
    }

    private async Task HandleValueScan(Func<IntPtr, int> getCurrentValue, int processId)
    {
        if (IsFirstScan)
        {
            HandleFirstScan(processId);
            if (scanResults.Count > 0)
            {
                ProcessInitialValues(getCurrentValue);
            }
            else
            {
                Logger.LogWarning("First scan returned no results to process");
            }
        }
        else
        {
            await HandleSubsequentScan(getCurrentValue);
        }
    }

    private void HandleFirstScan(int processId)
    {
        Logger.LogInformation("Starting first scan for process {ProcessId} with scan type {ScanType}",
            processId, ScanType);

        switch (ScanType)
        {
            case ScanType.ExactValue:
                Logger.LogDebug("Scanning for exact value: {SearchValue} of type {ValueType}",
                    SearchValue, ValueType);
                scanResults = MemoryScanner.ScanForValue(
                    processId,
                    SearchValue,
                    ValueType).Result;
                Logger.LogDebug("Exact value scan completed with {Count} results", scanResults.Count);
                break;

            case ScanType.UnknownInitialValue:
                Logger.LogDebug("Getting all addresses for value type {ValueType}", ValueType);
                scanResults = MemoryScanner.GetAllAddresses(
                    processId,
                    ValueType).Result;
                Logger.LogDebug("Retrieved {Count} addresses", scanResults.Count);
                break;
        }
    }

    private void ProcessInitialValues(Func<IntPtr, int> getCurrentValue)
    {
        Logger.LogInformation("Reading initial values for {Count} addresses", scanResults.Count);
        var processedCount = 0;
        var errorCount = 0;
        var batchStartTime = DateTime.UtcNow;

        foreach (var address in scanResults)
        {
            try
            {
                previousValues[address] = getCurrentValue(address);
                processedCount++;

                if (processedCount % 1000 == 0)
                {
                    var currentTime = DateTime.UtcNow;
                    var batchDuration = currentTime - batchStartTime;
                    Logger.LogDebug("Processed {Count}/{Total} addresses ({Rate:F2} addresses/sec)",
                        processedCount,
                        scanResults.Count,
                        1000 / batchDuration.TotalSeconds);
                    batchStartTime = currentTime;
                }
            }
            catch (Exception ex)
            {
                errorCount++;
                Logger.LogError(ex, "Failed to read value at address {Address}", address);
                if (errorCount % 100 == 0)
                {
                    Logger.LogError("Encountered {ErrorCount} read errors so far", errorCount);
                }
            }
        }

        var duration = DateTime.UtcNow - batchStartTime;
        Logger.LogInformation(
            "Completed reading initial values in {Duration:F2}s. Processed: {Processed}, Errors: {Errors}",
            duration.TotalSeconds, processedCount, errorCount);
    }

    private async Task HandleSubsequentScan(Func<IntPtr, int> getCurrentValue)
    {
        Logger.LogInformation("Starting subsequent scan for {Count} addresses with type {ScanType}",
            scanResults.Count, ScanType);
        var startTime = DateTime.UtcNow;
        var newResults = new List<IntPtr>();
        var processedCount = 0;
        var errorCount = 0;
        var matchCount = 0;
        var batchStartTime = DateTime.UtcNow;

        foreach (var address in scanResults)
        {
            try
            {
                var currentValue = getCurrentValue(address);
                var previousValue = previousValues[address];
                processedCount++;

                bool keepResult = ScanType switch
                {
                    ScanType.ExactValue => currentValue == SearchValue,
                    ScanType.IncreasedValue => currentValue > previousValue,
                    ScanType.DecreasedValue => currentValue < previousValue,
                    ScanType.ChangedValue => currentValue != previousValue,
                    ScanType.UnchangedValue => currentValue == previousValue,
                    _ => false
                };

                if (keepResult)
                {
                    matchCount++;
                    newResults.Add(address);
                    previousValues[address] = currentValue;
                }

                if (processedCount % 1000 == 0)
                {
                    var currentTime = DateTime.UtcNow;
                    var batchDuration = currentTime - batchStartTime;
                    Logger.LogDebug(
                        "Processed {Count}/{Total} addresses ({Rate:F2} addresses/sec). Matches: {Matches}",
                        processedCount,
                        scanResults.Count,
                        1000 / batchDuration.TotalSeconds,
                        matchCount);
                    batchStartTime = currentTime;
                }
            }
            catch (Exception ex)
            {
                errorCount++;
                Logger.LogError(ex, "Failed to process address {Address}", address);
                if (errorCount % 100 == 0)
                {
                    Logger.LogError("Encountered {ErrorCount} processing errors so far", errorCount);
                }
            }
        }

        var duration = DateTime.UtcNow - startTime;
        Logger.LogInformation(
            "Completed subsequent scan in {Duration:F2}s. Processed: {Processed}, Matches: {Matches}, Errors: {Errors}",
            duration.TotalSeconds, processedCount, matchCount, errorCount);

        scanResults = newResults;
    }

    public void Reset()
    {
        scanResults.Clear();
        previousValues.Clear();
    }
}
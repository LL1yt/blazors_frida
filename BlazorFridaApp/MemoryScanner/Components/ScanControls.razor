@inherits MemoryScannerComponentBase
@using BlazorFridaApp.MemoryScanner.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel
@using Blazorise

<div>
    <Row>
        <Column>
            <ErrorBoundary>
                <ChildContent>
                    <Select TValue="ScanType"
                            @bind-Value="@ScanType"
                            Style="width: 200px">
                        @foreach (var type in ScanTypes)
                        {
                            <SelectItem Value="@type">@type</SelectItem>
                        }
                    </Select>
                </ChildContent>
                <ErrorContent>
                    <Alert Color="Color.Danger">An error occurred loading scan types</Alert>
                </ErrorContent>
            </ErrorBoundary>
        </Column>
        <Column>
            <ErrorBoundary>
                <ChildContent>
                    <Select TValue="MemoryValueType"
                            @bind-Value="@ValueType"
                            Style="width: 200px">
                        @foreach (var type in ValueTypes)
                        {
                            <SelectItem Value="@type">@type</SelectItem>
                        }
                    </Select>
                </ChildContent>
                <ErrorContent>
                    <Alert Color="Color.Danger">An error occurred loading value types</Alert>
                </ErrorContent>
            </ErrorBoundary>
        </Column>
    </Row>

    @if (ScanType == ScanType.Pattern)
    {
        <div class="pattern-inputs">
            <MemoEdit Text="@PatternHex"
                     TextChanged="@OnPatternHexChanged"
                     Placeholder="Pattern (hex, space-separated)"
                     Rows="2" />
                     
            <MemoEdit Text="@Mask"
                     TextChanged="@OnMaskChanged"
                     Placeholder="Mask (x - match, ? - wildcard)"
                     Rows="2" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <Alert Color="Color.Danger" Margin="Margin.Is3.FromTop">@_errorMessage</Alert>
            }
        </div>
    }
    else
    {
        @if (ValueType == MemoryValueType.String)
        {
            <TextEdit @bind-Text="@StringSearchValue"
                     Placeholder="Search text value" />
        }
        else
        {
            <NumericEdit TValue="int"
                        @bind-Value="@SearchValue"
                        Placeholder="Search value" />
        }
                    
        @if (ScanType == ScanType.UnknownInitialValue)
        {
            <div class="text-muted">
                Perform first scan to initialize, then change value in game and perform next scan
            </div>
        }
    }

    @if (IsFirstScan)
    {
        <Button Color="Color.Primary"
                Disabled="@(!CanScan || IsLoading || !IsValid)"
                Clicked="@OnScanClick">
            <Blazorise.Icon Name="@(IsLoading ? FontAwesomeIcons.Refresh : FontAwesomeIcons.Search)" />
            First Memory Scan
        </Button>
    }
    else 
    {
        <Button Color="Color.Secondary"
                Disabled="@(!CanScan || IsLoading || !IsValid)"
                Clicked="@OnScanClick">
            <Blazorise.Icon Name="@(IsLoading ? FontAwesomeIcons.Refresh : FontAwesomeIcons.Search)" />
            Next Scan
        </Button>
    }

    @if (IsLoading)
    {
        <Progress Striped Animated>
            <ProgressBar Value="100" />
        </Progress>
    }
</div>

@code {
    private string? _errorMessage;
    private bool IsValid => string.IsNullOrEmpty(_errorMessage);
    private string StringSearchValue { get; set; } = string.Empty;

    [Parameter] public ScanType ScanType { get; set; }
    [Parameter] public MemoryValueType ValueType { get; set; }
    [Parameter] public required Array ScanTypes { get; set; }
    [Parameter] public required Array ValueTypes { get; set; }
    [Parameter] public required string PatternHex { get; set; }
    [Parameter] public EventCallback<string> PatternHexChanged { get; set; }
    [Parameter] public required string Mask { get; set; }
    [Parameter] public EventCallback<string> MaskChanged { get; set; }
    [Parameter] public int SearchValue { get; set; }
    [Parameter] public EventCallback<int> SearchValueChanged { get; set; }
    [Parameter] public bool IsFirstScan { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool CanScan { get; set; }
    [Parameter] public EventCallback<ScanType> OnScanTypeChanged { get; set; }
    [Parameter] public EventCallback<MemoryValueType> OnValueTypeChanged { get; set; }
    [Parameter] public EventCallback OnScanClick { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ValueType == MemoryValueType.String && SearchValue != 0)
        {
            StringSearchValue = SearchValue.ToString();
        }
    }

    private async Task OnPatternHexChanged(string value)
    {
        ValidatePattern(value);
        await PatternHexChanged.InvokeAsync(value);
    }

    private async Task OnMaskChanged(string value)
    {
        ValidateMask(value);
        await MaskChanged.InvokeAsync(value);
    }

    private void ValidatePattern(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _errorMessage = "Pattern cannot be empty";
            return;
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            if (!byte.TryParse(part, System.Globalization.NumberStyles.HexNumber, null, out _))
            {
                _errorMessage = "Invalid pattern format";
                return;
            }
        }

        ValidateMaskLength(parts.Length);
    }

    private void ValidateMask(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _errorMessage = "Mask cannot be empty";
            return;
        }

        if (!value.All(c => c == 'x' || c == '?'))
        {
            _errorMessage = "Mask can only contain 'x' or '?'";
            return;
        }

        var patternLength = PatternHex?.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length ?? 0;
        ValidateMaskLength(patternLength);
    }

    private void ValidateMaskLength(int patternLength)
    {
        if (patternLength > 0 && Mask?.Length != patternLength)
        {
            _errorMessage = "Pattern and mask must have the same length";
            return;
        }

        _errorMessage = null;
    }
}

@using BlazorFridaApp.MemoryScanner.Models
@using Radzen
@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Web

<RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
    <ErrorBoundary>
        <ChildContent>
            <RadzenDropDown TValue="ScanType"
                          @bind-Value="@ScanType"
                          Data="@ScanTypes"
                          AllowClear="true"
                          Style="width: 200px"
                          Change="@(args => OnScanTypeChanged.InvokeAsync(args))"
                          Placeholder="Scan type"/>
        </ChildContent>
        <ErrorContent>
            @{
                var error = context as Exception;
                <div class="alert alert-danger">@error?.Message</div>
            }
        </ErrorContent>
    </ErrorBoundary>
    
    <ErrorBoundary>
        <ChildContent>
            <RadzenDropDown TValue="MemoryValueType"
                          @bind-Value="@ValueType"
                          Data="@ValueTypes"
                          Style="width: 200px"
                          AllowClear="true"
                          Change="@(args => OnValueTypeChanged.InvokeAsync(args))"
                          Placeholder="Value type"/>
        </ChildContent>
        <ErrorContent>
            @{
                var error = context as Exception;
                <div class="alert alert-danger">@error?.Message</div>
            }
        </ErrorContent>
    </ErrorBoundary>
</RadzenStack>

@if (ScanType == ScanType.Pattern)
{
    <div class="pattern-inputs">
        <RadzenTextArea @bind-Value="@PatternHex"
                       Placeholder="Pattern (hex, space-separated)"
                       Change="@ValidatePattern"
                       Rows="2"/>
                   
        <RadzenTextArea @bind-Value="@Mask"
                       Placeholder="Mask (x - match, ? - wildcard)"
                       Change="@ValidateMask"
                       Rows="2"/>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mt-2">@_errorMessage</div>
        }
    </div>
}
else
{
    <RadzenNumeric Value="@SearchValue"
                   ValueChanged="@(async (int val) => await SearchValueChanged.InvokeAsync(val))"
                   Placeholder="Search value"
                   Style="width: 100%"/>
                  
    @if (ScanType == ScanType.UnknownInitialValue)
    {
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
            Perform first scan to initialize, then change value in game and perform next scan
        </RadzenText>
    }
}

<RadzenButton Text="@(IsFirstScan ? "First Scan" : "Next Scan")"
             Click="@OnScanClick"
             Disabled="@(!CanScan || IsLoading || !IsValid)"
             ButtonStyle="ButtonStyle.Primary"
             Icon="@(IsLoading ? "refresh" : "search")"
             class="@(IsLoading ? "rz-button-loading" : "")"
             Style="min-width: 150px"/>

@if (IsLoading)
{
    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
}

@code {
    private string? _errorMessage;
    private bool IsValid => string.IsNullOrEmpty(_errorMessage);

    [Parameter] public ScanType ScanType { get; set; }
    [Parameter] public MemoryValueType ValueType { get; set; }
    [Parameter] public required Array ScanTypes { get; set; }
    [Parameter] public required Array ValueTypes { get; set; }
    [Parameter] public required string PatternHex { get; set; }
    [Parameter] public required string Mask { get; set; }
    [Parameter] public int SearchValue { get; set; }
    [Parameter] public EventCallback<int> SearchValueChanged { get; set; }
    [Parameter] public bool IsFirstScan { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool CanScan { get; set; }
    [Parameter] public EventCallback<ScanType> OnScanTypeChanged { get; set; }
    [Parameter] public EventCallback<MemoryValueType> OnValueTypeChanged { get; set; }
    [Parameter] public EventCallback OnScanClick { get; set; }

    private void ValidatePattern(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _errorMessage = "Pattern cannot be empty";
            return;
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            if (!byte.TryParse(part, System.Globalization.NumberStyles.HexNumber, null, out _))
            {
                _errorMessage = "Invalid pattern format";
                return;
            }
        }

        ValidateMaskLength(parts.Length);
    }

    private void ValidateMask(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _errorMessage = "Mask cannot be empty";
            return;
        }

        if (!value.All(c => c == 'x' || c == '?'))
        {
            _errorMessage = "Mask can only contain 'x' or '?'";
            return;
        }

        var patternLength = PatternHex?.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length ?? 0;
        ValidateMaskLength(patternLength);
    }

    private void ValidateMaskLength(int patternLength)
    {
        if (patternLength > 0 && Mask?.Length != patternLength)
        {
            _errorMessage = "Pattern and mask must have the same length";
            return;
        }

        _errorMessage = null;
    }
}

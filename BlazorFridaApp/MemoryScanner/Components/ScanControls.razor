@inherits MemoryScannerComponentBase
@using BlazorFridaApp.MemoryScanner.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel
@using BlazorFridaApp.Components.Base

<div class="scan-controls">
    <div class="row">
        <div class="col">
            <div class="mb-3">
                <BaseSelect TValue="ScanType"
                           Label="Scan Type"
                           Value="@ScanType"
                           ValueChanged="@(async (ScanType type) => await OnScanTypeChanged.InvokeAsync(type))"
                           Class="scan-type-select">
                    @foreach (var type in ScanTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </BaseSelect>
            </div>
        </div>
        <div class="col">
            <div class="mb-3">
                <BaseSelect TValue="MemoryValueType"
                           Label="Value Type"
                           Value="@ValueType"
                           ValueChanged="@OnValueTypeChanged"
                           Class="value-type-select">
                    @foreach (var type in ValueTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </BaseSelect>
                @if (ValueType == MemoryValueType.ByteArray)
                {
                    <BaseAlert Color="warning" Class="mt-2">
                        Byte arrays are not supported yet
                    </BaseAlert>
                }
            </div>
        </div>
    </div>

    <div class="search-section mt-4">
        @if (ScanType == ScanType.Pattern)
        {
            <div class="pattern-inputs">
                <div class="mb-3">
                    <BaseInput Type="text"
                              Label="Pattern (hex, space-separated)"
                              Value="@PatternHex"
                              ValueChanged="@PatternHexChanged"
                              Class="pattern-input" />
                    @if (!string.IsNullOrEmpty(_patternError))
                    {
                        <BaseAlert Color="danger" Class="mt-2">@_patternError</BaseAlert>
                    }
                </div>
                             
                <div class="mb-3">
                    <BaseInput Type="text"
                              Label="Mask (x - match, ? - wildcard)"
                              Value="@Mask"
                              ValueChanged="@MaskChanged"
                              Class="mask-input" />
                    @if (!string.IsNullOrEmpty(_maskError))
                    {
                        <BaseAlert Color="danger" Class="mt-2">@_maskError</BaseAlert>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <BaseInput Type="@(ValueType == MemoryValueType.String ? "text" : "number")"
                          Label="Search Value"
                          Value="@(ValueType == MemoryValueType.String ? StringSearchValue : SearchValue.ToString())"
                          ValueChanged="@(v => SearchValueChanged.InvokeAsync(int.Parse(v)))"
                          Placeholder="@(ValueType == MemoryValueType.String ? "Enter text to search" : "Enter number to search")"
                          Class="search-input" />
                @if (!string.IsNullOrEmpty(_searchValueError))
                {
                    <BaseAlert Color="danger" Class="mt-2">@_searchValueError</BaseAlert>
                }
            </div>
                        
            @if (ScanType == ScanType.UnknownInitialValue)
            {
                <div class="text-muted mt-2">
                    Perform first scan to initialize, then change value in game and perform next scan
                </div>
            }
        }
    </div>

    <div class="scan-actions mt-4">
        @if (!SelectedProcessId.HasValue)
        {
            <BaseAlert Color="warning">Please select a process first</BaseAlert>
        }

        @if (IsFirstScan)
        {
            <BaseButton Color="primary"
                       Class="w-100"
                       Disabled="@IsLoading"
                       OnClick="@OnValidatedScanClick"
                       Icon="@(IsLoading ? "fas fa-refresh" : "fas fa-search")">
                First Memory Scan
            </BaseButton>
        }
        else 
        {
            <BaseButton Color="secondary"
                       Class="w-100"
                       Disabled="@IsLoading"
                       OnClick="@OnValidatedScanClick"
                       Icon="@(IsLoading ? "fas fa-refresh" : "fas fa-search")">
                Next Scan
            </BaseButton>
        }

        @if (IsLoading)
        {
            <div class="progress mt-3">
                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" 
                     style="width: 100%"></div>
            </div>
        }
    </div>
</div>

<style>
    .scan-controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pattern-input,
    .mask-input {
        font-family: monospace;
    }

    .scan-actions {
        margin-top: auto;
    }

    .progress {
        height: 0.5rem;
        border-radius: 1rem;
    }
</style>

@code {
    private string _patternError = string.Empty;
    private string _maskError = string.Empty;
    private string _searchValueError = string.Empty;
    public string StringSearchValue { get; private set; } = string.Empty;

    [Parameter] public ScanType ScanType { get; set; }
    [Parameter] public MemoryValueType ValueType { get; set; }
    [Parameter] public required Array ScanTypes { get; set; }
    [Parameter] public required Array ValueTypes { get; set; }
    [Parameter] public required string PatternHex { get; set; }
    [Parameter] public EventCallback<string> PatternHexChanged { get; set; }
    [Parameter] public required string Mask { get; set; }
    [Parameter] public EventCallback<string> MaskChanged { get; set; }
    [Parameter] public int SearchValue { get; set; }
    [Parameter] public EventCallback<int> SearchValueChanged { get; set; }
    [Parameter] public bool IsFirstScan { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool CanScan { get; set; }
    [Parameter] public int? SelectedProcessId { get; set; }
    [Parameter] public EventCallback<ScanType> OnScanTypeChanged { get; set; }
    [Parameter] public EventCallback<MemoryValueType> OnValueTypeChanged { get; set; }
    [Parameter] public EventCallback OnScanClick { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Logger.LogDebug("ScanControls parameters updated:\n" +
            "- ScanType: {ScanType}\n" +
            "- ValueType: {ValueType}\n" +
            "- IsFirstScan: {IsFirstScan}\n" +
            "- IsLoading: {IsLoading}\n" +
            "- CanScan: {CanScan}\n" +
            "- SelectedProcessId: {ProcessId}",
            ScanType, ValueType, IsFirstScan, IsLoading, CanScan, SelectedProcessId);

        if (ValueType == MemoryValueType.String && SearchValue != 0)
        {
            StringSearchValue = SearchValue.ToString();
        }
    }

    private async Task OnValidatedScanClick()
    {
        if (OnScanClick.HasDelegate)
        {
            await OnScanClick.InvokeAsync();
        }
    }
}

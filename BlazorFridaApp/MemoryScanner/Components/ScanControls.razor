@inherits MemoryScannerComponentBase
@using BlazorFridaApp.MemoryScanner.Models
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel
@using BlazorFridaApp.Components.Base

<div class="scan-controls">
    <div class="row">
        <div class="col">
            <div class="mb-3">
                <label class="form-label">Scan Type</label>
                <select class="form-select scan-type-select" value="@ScanType" @onchange="@(async (ChangeEventArgs e) => await OnScanTypeChanged.InvokeAsync(Enum.Parse<ScanType>(e.Value?.ToString() ?? "")))">
                    @foreach (var type in ScanTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
        </div>
        <div class="col">
            <div class="mb-3">
                <label class="form-label">Value Type</label>
                <select class="form-select value-type-select" value="@ValueType" @onchange="@(e => OnValueTypeChanged.InvokeAsync(Enum.Parse<MemoryValueType>(e.Value?.ToString() ?? "")))">
                    @foreach (var type in ValueTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
                @if (ValueType == MemoryValueType.ByteArray)
                {
                    <div class="alert alert-warning mt-2">
                        Byte arrays are not supported yet
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="search-section mt-4">
        @if (ScanType == ScanType.Pattern)
        {
            <div class="pattern-inputs">
                <div class="mb-3">
                    <label class="form-label">Pattern (hex, space-separated)</label>
                    <input type="text"
                           class="form-control pattern-input"
                           value="@PatternHex"
                           @onchange="@(e => PatternHexChanged.InvokeAsync(e.Value?.ToString()))" />
                    @if (!string.IsNullOrEmpty(_patternError))
                    {
                        <div class="alert alert-danger mt-2">@_patternError</div>
                    }
                </div>
                             
                <div class="mb-3">
                    <label class="form-label">Mask (x - match, ? - wildcard)</label>
                    <input type="text"
                           class="form-control mask-input"
                           value="@Mask"
                           @onchange="@(e => MaskChanged.InvokeAsync(e.Value?.ToString()))" />
                    @if (!string.IsNullOrEmpty(_maskError))
                    {
                        <div class="alert alert-danger mt-2">@_maskError</div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                @if (ValueType == MemoryValueType.String)
                {
                    <label class="form-label">Search Value</label>
                    <input type="text"
                           class="form-control search-input"
                           value="@StringSearchValue"
                           placeholder="Enter text to search"
                           @onchange="@(e => OnStringValueChanged(e.Value?.ToString()))" />
                }
                else
                {
                    <label class="form-label">Search Value</label>
                    <input type="number"
                           class="form-control search-input"
                           value="@SearchValue"
                           placeholder="Enter number to search"
                           @onchange="@(e => OnNumericValueChanged(e.Value?.ToString()))" />
                }
                @if (!string.IsNullOrEmpty(_searchValueError))
                {
                    <div class="alert alert-danger mt-2">@_searchValueError</div>
                }
            </div>
                        
            @if (ScanType == ScanType.UnknownInitialValue)
            {
                <div class="text-muted mt-2">
                    Perform first scan to initialize, then change value in game and perform next scan
                </div>
            }
        }
    </div>

    <div class="scan-actions mt-4">
        @if (!SelectedProcessId.HasValue)
        {
            <div class="alert alert-warning">Please select a process first</div>
        }

        <button type="button" 
                class="btn btn-primary w-100" 
                disabled="@(IsLoading || !CanScan)"
                @onclick="OnValidatedScanClick">
            <i class="@(IsLoading ? "fas fa-refresh" : "fas fa-search")"></i>
            @(IsFirstScan ? "First Memory Scan" : "Next Scan")
        </button>

        @if (IsLoading)
        {
            <div class="progress mt-3">
                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" 
                     style="width: 100%">
                </div>
            </div>
        }
    </div>
</div>

<style>
    .scan-controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pattern-input,
    .mask-input {
        font-family: monospace;
    }

    .scan-actions {
        margin-top: auto;
    }

    .progress {
        height: 0.5rem;
        border-radius: 1rem;
    }
</style>

@code {
    private string _patternError = string.Empty;
    private string _maskError = string.Empty;
    private string _searchValueError = string.Empty;
    public string StringSearchValue { get; private set; } = string.Empty;

    [Parameter] public ScanType ScanType { get; set; }
    [Parameter] public MemoryValueType ValueType { get; set; }
    [Parameter] public required Array ScanTypes { get; set; }
    [Parameter] public required Array ValueTypes { get; set; }
    [Parameter] public required string PatternHex { get; set; }
    [Parameter] public EventCallback<string> PatternHexChanged { get; set; }
    [Parameter] public required string Mask { get; set; }
    [Parameter] public EventCallback<string> MaskChanged { get; set; }
    [Parameter] public int SearchValue { get; set; }
    [Parameter] public EventCallback<int> SearchValueChanged { get; set; }
    [Parameter] public bool IsFirstScan { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool CanScan { get; set; }
    [Parameter] public int? SelectedProcessId { get; set; }
    [Parameter] public EventCallback<ScanType> OnScanTypeChanged { get; set; }
    [Parameter] public EventCallback<MemoryValueType> OnValueTypeChanged { get; set; }
    [Parameter] public EventCallback OnScanClick { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Logger.LogDebug("ScanControls parameters updated:\n" +
            "- ScanType: {ScanType}\n" +
            "- ValueType: {ValueType}\n" +
            "- IsFirstScan: {IsFirstScan}\n" +
            "- IsLoading: {IsLoading}\n" +
            "- CanScan: {CanScan}\n" +
            "- SelectedProcessId: {ProcessId}",
            ScanType, ValueType, IsFirstScan, IsLoading, CanScan, SelectedProcessId);

        if (ValueType == MemoryValueType.String && SearchValue != 0)
        {
            StringSearchValue = SearchValue.ToString();
        }
    }

    private async Task OnValidatedScanClick()
    {
        // Validate pattern scan inputs
        if (ScanType == ScanType.Pattern)
        {
            _patternError = string.Empty;
            _maskError = string.Empty;

            if (string.IsNullOrWhiteSpace(PatternHex))
            {
                _patternError = "Pattern cannot be empty";
                return;
            }

            if (string.IsNullOrWhiteSpace(Mask))
            {
                _maskError = "Mask cannot be empty";
                return;
            }

            try
            {
                var pattern = PatternHex.Split(' ').Select(b => Convert.ToByte(b, 16)).ToArray();
                if (pattern.Length != Mask.Length)
                {
                    _maskError = "Mask length must match pattern length";
                    return;
                }
            }
            catch
            {
                _patternError = "Pattern must be space-separated hex bytes";
                return;
            }
        }
        else
        {
            _searchValueError = string.Empty;
            if ((ValueType == MemoryValueType.String && string.IsNullOrEmpty(StringSearchValue)) ||
                (ValueType != MemoryValueType.String && SearchValue == 0))
            {
                _searchValueError = "Search value cannot be empty";
                return;
            }
        }

        if (OnScanClick.HasDelegate)
        {
            await OnScanClick.InvokeAsync();
        }
    }

    private void OnStringValueChanged(string? value)
    {
        StringSearchValue = value ?? string.Empty;
        StateHasChanged();
    }

    private void OnNumericValueChanged(string? value)
    {
        if (int.TryParse(value, out int numericValue))
        {
            SearchValueChanged.InvokeAsync(numericValue);
        }
    }
}

@using Radzen
@using Radzen.Blazor
@using BlazorFridaApp.MemoryScanner.Models
@inject ILogger<ProcessSelector> Logger

<div>
@code {
    protected override void OnInitialized()
    {
        Logger.LogInformation("ProcessSelector component initialized");
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        Logger.LogDebug("ProcessSelector parameters updated: ProcessList count: {Count}, SelectedProcessId: {ProcessId}, IsLoading: {IsLoading}",
            ProcessList?.Count ?? 0, SelectedProcessId, IsLoading);
        base.OnParametersSet();
    }
}

    <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenDropDown TValue="int?"
                        @bind-Value="@SelectedProcessId"
                        Data="@ProcessList"
                        ValueProperty="Id"
                        TextProperty="Name"
                        TextTemplate="@ProcessTemplate"
                        Placeholder="Select process"
                        Change="@(args => HandleProcessSelected())"
                        AllowClear="true"
                        AllowFiltering="true"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        Style="width: 80%"/>
        <RadzenButton Icon="refresh"
                      Click="@HandleRefreshClick"
                      ButtonStyle="ButtonStyle.Light"
                      Title="Scan processes"
                      Text="Scan"
                      Disabled="@IsLoading"/>
    </RadzenStack>
    @if (IsLoading)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="mt-2"/>
    }
</div>

@code {
    [Parameter] public required List<ProcessInfo> ProcessList { get; set; }
    [Parameter] public int? SelectedProcessId { get; set; }
    [Parameter] public EventCallback OnProcessSelected { get; set; }
    [Parameter] public EventCallback OnRefreshClick { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private async Task HandleProcessSelected()
    {
        try
        {
            Logger.LogInformation("Process selection changed to ID: {ProcessId}", SelectedProcessId);
            await OnProcessSelected.InvokeAsync();
            Logger.LogDebug("Process selection handler completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling process selection for ID: {ProcessId}", SelectedProcessId);
            throw;
        }
    }

    private async Task HandleRefreshClick()
    {
        try
        {
            Logger.LogInformation("Process list refresh requested");
            await OnRefreshClick.InvokeAsync();
            Logger.LogDebug("Process list refresh handler completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling process list refresh");
            throw;
        }
    }

    private RenderFragment<ProcessInfo> ProcessTemplate => (process) => builder =>
    {
        try
        {
            Logger.LogTrace("Rendering process template for {Name} ({Id})", process.Name, process.Id);
            builder.AddContent(0, $"{process.Name} ({process.Id})");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error rendering process template for process ID: {Id}", process.Id);
            throw;
        }
    };
}
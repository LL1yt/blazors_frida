@using Blazorise
@using BlazorFridaApp.MemoryScanner.Models
@using BlazorFridaApp.MemoryScanner.Services.Interfaces
@inject ILogger<ProcessSelector> Logger
@inject IProcessService ProcessService
@implements IAsyncDisposable

<div>
    <Row>
        <Column ColumnSize="ColumnSize.Is9">
            <Select TValue="int?" 
                   @bind-SelectedValue="@SelectedProcessId"
                   Disabled="@IsLoading"
                   SearchChanged="@((string value) => { _searchTerm = value; StateHasChanged(); })">
                <ChildContent>
                    <SelectItem TValue="int?" Value="null">@(IsLoading ? "Loading processes..." : "Select a process")</SelectItem>
                    @foreach (var process in FilteredProcesses)
                    {
                        <SelectItem TValue="int?" Value="@process.Id">@($"{process.Name} ({process.Id})")</SelectItem>
                    }
                </ChildContent>
            </Select>
        </Column>
        @if (ShowRefreshButton)
        {
            <Column ColumnSize="ColumnSize.Is3">
                <Button Color="Color.Primary" 
                        Disabled="@IsLoading"
                        Clicked="@HandleRefreshClick">
                    <Blazorise.Icon Name="@(IsLoading ? "fas fa-hourglass-half" : "fas fa-sync")" />
                    @(IsLoading ? "Loading..." : "Process Scan")
                </Button>
            </Column>
        }
    </Row>
    @if (IsLoading)
    {
        <Progress Striped Animated>
            <ProgressBar Value="100" />
        </Progress>
    }
</div>

@code {
    [Parameter] public List<ProcessInfo> ProcessList { get; set; } = new();
    [Parameter] public int? SelectedProcessId { get; set; }
    [Parameter] public EventCallback<int?> OnProcessSelected { get; set; }
    [Parameter] public EventCallback OnRefreshClick { get; set; }
    [Parameter] public bool ShowRefreshButton { get; set; } = true;
    [Parameter] public bool IsLoading { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private readonly Stopwatch _lifecycleTimer = new();
    private readonly Stopwatch _operationTimer = new();
    private int _renderCount = 0;
    private string _searchTerm = string.Empty;

    public async Task InitializeAsync()
    {
        try
        {
            IsLoading = true;
            ProcessList = await ProcessService.GetProcessesAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize process list");
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ValidateComponentState(string operation)
    {
        try
        {
            if (ProcessList == null)
            {
                Logger.LogWarning("{Operation}: ProcessList is null", operation);
            }
            
            if (IsLoading)
            {
                Logger.LogDebug("{Operation}: Component is in loading state", operation);
            }

            if (SelectedProcessId.HasValue)
            {
                var processExists = ProcessList?.Any(p => p.Id == SelectedProcessId.Value) ?? false;
                if (!processExists)
                {
                    Logger.LogWarning(
                        "{Operation}: Selected process ID {ProcessId} not found in process list",
                        operation, SelectedProcessId.Value);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating component state during {Operation}", operation);
            throw;
        }
    }

    protected override void OnInitialized()
    {
        _lifecycleTimer.Start();
        Logger.LogInformation(
            "Initializing ProcessSelector component. Component ID: {ComponentId}",
            GetHashCode());
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        Logger.LogDebug(
            "ProcessSelector parameters updating at {ElapsedMs}ms. ProcessList count: {Count}, SelectedProcessId: {ProcessId}, IsLoading: {IsLoading}, RenderCount: {RenderCount}",
            _lifecycleTimer.ElapsedMilliseconds,
            ProcessList?.Count ?? 0,
            SelectedProcessId,
            IsLoading,
            _renderCount);

        // Ensure selection stays valid
        if (SelectedProcessId.HasValue && ProcessList != null)
        {
            var processExists = ProcessList.Any(p => p.Id == SelectedProcessId.Value);
            if (!processExists)
            {
                Logger.LogWarning("Selected process {ProcessId} no longer exists in the list", SelectedProcessId.Value);
            }
        }
        
        base.OnParametersSet();
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _renderCount++;
        if (firstRender)
        {
            Logger.LogInformation(
                "ProcessSelector component rendered for the first time after {ElapsedMs}ms. Component ID: {ComponentId}",
                _lifecycleTimer.ElapsedMilliseconds,
                GetHashCode());
        }
        else
        {
            Logger.LogTrace(
                "ProcessSelector re-rendered (#{RenderCount}) at {ElapsedMs}ms. State: {{ ProcessCount: {Count}, SelectedId: {ProcessId}, IsLoading: {IsLoading} }}",
                _renderCount,
                _lifecycleTimer.ElapsedMilliseconds,
                ProcessList?.Count ?? 0,
                SelectedProcessId,
                IsLoading);
        }
        base.OnAfterRender(firstRender);
    }

    private async Task HandleProcessSelected()
    {
        _operationTimer.Restart();
        ValidateComponentState("ProcessSelection");
        
        try
        {
            var previousId = SelectedProcessId;
            Logger.LogInformation(
                "Process selection changing from {PreviousId} to {NewId} at {ElapsedMs}ms",
                previousId, SelectedProcessId, _lifecycleTimer.ElapsedMilliseconds);

            if (IsLoading)
            {
                Logger.LogWarning(
                    "Process selection attempted while component is loading. Previous: {PreviousId}, New: {NewId}",
                    previousId, SelectedProcessId);
                return;
            }

            await OnProcessSelected.InvokeAsync(SelectedProcessId);
            StateHasChanged();
            
            _operationTimer.Stop();
            Logger.LogDebug(
                "Process selection handler completed in {OpElapsedMs}ms (total uptime: {TotalElapsedMs}ms). Previous: {PreviousId}, New: {NewId}, IsLoading: {IsLoading}",
                _operationTimer.ElapsedMilliseconds,
                _lifecycleTimer.ElapsedMilliseconds,
                previousId,
                SelectedProcessId,
                IsLoading);

            ValidateComponentState("PostProcessSelection");
        }
        catch (Exception ex)
        {
            _operationTimer.Stop();
            Logger.LogError(ex,
                "Error handling process selection after {OpElapsedMs}ms (total uptime: {TotalElapsedMs}ms). ID: {ProcessId}, IsLoading: {IsLoading}",
                _operationTimer.ElapsedMilliseconds,
                _lifecycleTimer.ElapsedMilliseconds,
                SelectedProcessId,
                IsLoading);
            throw;
        }
    }

    private async Task HandleRefreshClick()
    {
        _operationTimer.Restart();
        ValidateComponentState("ProcessListRefresh");
        
        try
        {
            var currentProcessCount = ProcessList?.Count ?? 0;
            Logger.LogInformation(
                "Process list refresh requested at {ElapsedMs}ms. Current count: {Count}, Selected: {ProcessId}, IsLoading: {IsLoading}",
                _lifecycleTimer.ElapsedMilliseconds,
                currentProcessCount,
                SelectedProcessId,
                IsLoading);

            if (IsLoading)
            {
                Logger.LogWarning("Process list refresh attempted while component is already loading");
                return;
            }

            IsLoading = true;
            ProcessList = await ProcessService.RefreshProcessesAsync(_cts.Token);
            await OnRefreshClick.InvokeAsync();

            var newProcessCount = ProcessList?.Count ?? 0;
            _operationTimer.Stop();
            Logger.LogDebug(
                "Process list refresh completed in {OpElapsedMs}ms (total uptime: {TotalElapsedMs}ms). Previous count: {PreviousCount}, New count: {NewCount}, IsLoading: {IsLoading}",
                _operationTimer.ElapsedMilliseconds,
                _lifecycleTimer.ElapsedMilliseconds,
                currentProcessCount,
                newProcessCount,
                IsLoading);

            ValidateComponentState("PostProcessListRefresh");
        }
        catch (Exception ex)
        {
            _operationTimer.Stop();
            Logger.LogError(ex,
                "Error handling process list refresh after {OpElapsedMs}ms (total uptime: {TotalElapsedMs}ms). IsLoading: {IsLoading}",
                _operationTimer.ElapsedMilliseconds,
                _lifecycleTimer.ElapsedMilliseconds,
                IsLoading);
            throw;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    public async Task HandleFilter(ChangeEventArgs args)
    {
        _searchTerm = args?.Value?.ToString() ?? string.Empty;
        StateHasChanged();
        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Logger.LogInformation(
            "Disposing ProcessSelector component after {ElapsedMs}ms. Component ID: {ComponentId}, Final render count: {RenderCount}",
            _lifecycleTimer.ElapsedMilliseconds,
            GetHashCode(),
            _renderCount);
        _lifecycleTimer.Stop();
        _cts.Cancel();
        await ValueTask.CompletedTask;
    }

    private IEnumerable<ProcessInfo> FilteredProcesses => ProcessList?
        .Where(p => string.IsNullOrEmpty(_searchTerm) || 
                    p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<ProcessInfo>();

    private bool FilterProcesses(object item)
    {
        if (string.IsNullOrEmpty(_searchTerm))
            return true;

        if (item is SelectItem<int?> selectItem && selectItem.Value.HasValue)
        {
            var process = ProcessList.FirstOrDefault(p => p.Id == selectItem.Value.Value);
            return process != null && process.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }
}
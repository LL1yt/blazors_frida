@using BlazorFridaApp.MemoryScanner.Models
@using BlazorFridaApp.Services.Interfaces
@using BlazorFridaApp.Components.Base
@inject ILogger<ProcessSelector> Logger
@inject IProcessService ProcessService
@implements IAsyncDisposable

<div class="process-selector">
    <div class="input-group mb-3">
        <select class="form-select" @bind="SelectedProcessId">
            <option value="">Select a process...</option>
            @if (Processes != null)
            {
                @foreach (var process in Processes)
                {
                    <option value="@process.Id">@process.Name (@process.Id)</option>
                }
            }
        </select>
        <button class="btn btn-outline-secondary" @onclick="RefreshProcessList" disabled="@IsLoading">
            <i class="@(IsLoading ? "fas fa-hourglass-half" : "fas fa-sync")"></i>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public List<ProcessInfo> Processes { get; set; } = new();

    [Parameter]
    public int? SelectedProcessId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedProcessIdChanged { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public EventCallback OnRefreshClick { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private readonly Stopwatch _lifecycleTimer = new();
    private readonly Stopwatch _operationTimer = new();
    private int _renderCount = 0;
    private string _searchTerm = string.Empty;

    public async Task InitializeAsync()
    {
        try
        {
            IsLoading = true;
            Processes = await ProcessService.GetProcessesAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize process list");
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ValidateComponentState(string operation)
    {
        try
        {
            if (Processes == null)
            {
                Logger.LogWarning("{Operation}: ProcessList is null", operation);
            }
            
            if (IsLoading)
            {
                Logger.LogDebug("{Operation}: Component is in loading state", operation);
            }

            if (SelectedProcessId.HasValue)
            {
                var processExists = Processes?.Any(p => p.Id == SelectedProcessId.Value) ?? false;
                if (!processExists)
                {
                    Logger.LogWarning(
                        "{Operation}: Selected process ID {ProcessId} not found in process list",
                        operation, SelectedProcessId.Value);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating component state during {Operation}", operation);
            throw;
        }
    }

    protected override void OnInitialized()
    {
        _lifecycleTimer.Start();
        Logger.LogInformation(
            "Initializing ProcessSelector component. Component ID: {ComponentId}",
            GetHashCode());
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        Logger.LogDebug(
            "ProcessSelector parameters updating:\n" +
            "- Process List Count: {Count}\n" +
            "- Selected Process ID: {ProcessId}\n" +
            "- Is Loading: {IsLoading}\n" +
            "- Render Count: {RenderCount}\n" +
            "- Selected Process Exists: {ProcessExists}",
            Processes?.Count ?? 0,
            SelectedProcessId,
            IsLoading,
            _renderCount,
            SelectedProcessId.HasValue && Processes?.Any(p => p.Id == SelectedProcessId.Value) == true);

        // Ensure selection stays valid
        if (SelectedProcessId.HasValue && Processes != null)
        {
            var processExists = Processes.Any(p => p.Id == SelectedProcessId.Value);
            if (!processExists)
            {
                Logger.LogWarning(
                    "Selected process {ProcessId} no longer exists in the list. Available processes:\n{Processes}",
                    SelectedProcessId.Value,
                    string.Join("\n", Processes.Select(p => $"- {p.Name} ({p.Id})")));
            }
        }
        
        base.OnParametersSet();
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _renderCount++;
        if (firstRender)
        {
            Logger.LogInformation(
                "ProcessSelector component rendered for the first time after {ElapsedMs}ms. Component ID: {ComponentId}",
                _lifecycleTimer.ElapsedMilliseconds,
                GetHashCode());
        }
        else
        {
            Logger.LogTrace(
                "ProcessSelector re-rendered (#{RenderCount}) at {ElapsedMs}ms. State: {{ ProcessCount: {Count}, SelectedId: {ProcessId}, IsLoading: {IsLoading} }}",
                _renderCount,
                _lifecycleTimer.ElapsedMilliseconds,
                Processes?.Count ?? 0,
                SelectedProcessId,
                IsLoading);
        }
        base.OnAfterRender(firstRender);
    }

    private async Task RefreshProcessList()
    {
        try
        {
            IsLoading = true;
            Processes = await ProcessService.RefreshProcessesAsync(_cts.Token);
            await OnRefreshClick.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh process list");
            throw;
        }
        finally
        {
            IsLoading = false;
        }
    }

    public async Task HandleFilter(ChangeEventArgs args)
    {
        _searchTerm = args?.Value?.ToString() ?? string.Empty;
        StateHasChanged();
        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Logger.LogInformation(
            "Disposing ProcessSelector component after {ElapsedMs}ms. Component ID: {ComponentId}, Final render count: {RenderCount}",
            _lifecycleTimer.ElapsedMilliseconds,
            GetHashCode(),
            _renderCount);
        _lifecycleTimer.Stop();
        _cts.Cancel();
        await ValueTask.CompletedTask;
    }

    private IEnumerable<ProcessInfo> FilteredProcesses => Processes?
        .Where(p => string.IsNullOrEmpty(_searchTerm) || 
                    p.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<ProcessInfo>();

    private bool FilterProcesses(object item)
    {
        if (string.IsNullOrEmpty(_searchTerm))
            return true;

        if (item is SelectItem<int?> selectItem && selectItem.Value.HasValue)
        {
            var process = Processes.FirstOrDefault(p => p.Id == selectItem.Value.Value);
            return process != null && process.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }
}
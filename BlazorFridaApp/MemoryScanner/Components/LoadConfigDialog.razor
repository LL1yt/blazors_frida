@using Blazorise
@using Blazorise.DataGrid
@using Blazorise.Components
@using Blazorise.Icons.FontAwesome
@using BlazorFridaApp.Components.Pages
@using BlazorFridaApp.MemoryScanner.Services.Interfaces
@using BlazorFridaApp.MemoryScanner.Models

<div class="load-config-dialog">
    <DataGrid TItem="ConfigGridItem"
              Data="@GridData"
              Filterable
              Sortable
              RowClicked="@(args => selectedConfig = args.Item)"
              Margin="Margin.Is3.FromBottom">
        <DataGridColumn TItem="ConfigGridItem"
                       Field="@nameof(ConfigGridItem.Name)"
                       Caption="Name" />
        <DataGridColumn TItem="ConfigGridItem"
                       Field="@nameof(ConfigGridItem.ScanType)"
                       Caption="Scan Type" />
        <DataGridColumn TItem="ConfigGridItem"
                       Field="@nameof(ConfigGridItem.ValueType)"
                       Caption="Value Type" />
        <DataGridColumn TItem="ConfigGridItem"
                       Caption="Actions">
            <DisplayTemplate>
                <Button Color="Color.Danger"
                        Size="Size.Small"
                        Clicked="@(() => DeleteConfig(context.Name))">
                    <Blazorise.Icon Name="@FontAwesomeIcons.Trash" />
                </Button>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGrid>
    
    <div class="d-flex justify-content-end gap-2">
        <Button Color="Color.Light"
                Clicked="@OnCancel">
            Cancel
        </Button>
        <Button Color="Color.Primary"
                Clicked="@(() => OnConfigSelected.InvokeAsync(selectedConfig?.Config))"
                Disabled="@(selectedConfig == null)">
            Load
        </Button>
    </div>
</div>

@code {
    private class ConfigGridItem
    {
        public string Name { get; set; } = "";
        public string ScanType { get; set; } = "";
        public string ValueType { get; set; } = "";
        public ScannerConfig Config { get; set; } = new();

        public static ConfigGridItem FromKeyValuePair(KeyValuePair<string, ScannerConfig> kvp)
        {
            return new ConfigGridItem
            {
                Name = kvp.Key,
                ScanType = kvp.Value.ScanType.ToString(),
                ValueType = kvp.Value.ValueType.ToString(),
                Config = kvp.Value
            };
        }
    }

    [Parameter]
    public required Dictionary<string, Models.ScannerConfig> Configs { get; set; }

    [Parameter] public EventCallback<Models.ScannerConfig> OnConfigSelected { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }
    
    [Inject] public required IScanProfileService ProfileService { get; set; }
    [Inject] public required BlazorFridaApp.Services.INotificationService NotificationService { get; set; }

    private ConfigGridItem? selectedConfig;
    private IEnumerable<ConfigGridItem> GridData => Configs.Select(ConfigGridItem.FromKeyValuePair);

    private Task OnCancel() => OnCanceled.InvokeAsync();

    private async Task DeleteConfig(string name)
    {
        if (await NotificationService.Confirm($"Are you sure you want to delete '{name}'?", "Confirm Delete"))
        {
            await ProfileService.DeleteScannerConfig(name);
            Configs.Remove(name);
            StateHasChanged();
        }
    }
}
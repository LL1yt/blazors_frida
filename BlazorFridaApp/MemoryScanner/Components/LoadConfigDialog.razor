@using BlazorFridaApp.MemoryScanner.Models
@using BlazorFridaApp.Services.Interfaces

<div class="modal @(_isVisible ? "show d-block" : "d-none")" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Load Configuration</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (_configs != null && _configs.Any())
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var config in _configs)
                            {
                                <tr>
                                    <td>@config.Name</td>
                                    <td>@config.CreatedAt.ToLocalTime().ToString("g")</td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteConfig(config)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        <button class="btn btn-sm btn-primary ms-2" @onclick="() => LoadConfig(config)">
                                            Load
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">
                        No saved configurations found.
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
</div>

@if (_isVisible)
{
    <div class="modal-backdrop show"></div>
}

@code {
    private bool _isVisible;
    private required List<ScannerConfig> _configs;

    [Inject]
    public required IScanProfileService ScanProfileService { get; set; }

    [Parameter]
    public EventCallback<ScannerConfig> OnConfigurationSelected { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadConfigurations();
    }

    private async Task LoadConfigurations()
    {
        _configs = await ScanProfileService.GetAllConfigurationsAsync();
    }

    public async Task Show()
    {
        await LoadConfigurations();
        _isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task DeleteConfig(ScannerConfig config)
    {
        await ScanProfileService.DeleteConfigurationAsync(config.Name);
        await LoadConfigurations();
    }

    private async Task LoadConfig(ScannerConfig config)
    {
        await OnConfigurationSelected.InvokeAsync(config);
        Close();
    }
}
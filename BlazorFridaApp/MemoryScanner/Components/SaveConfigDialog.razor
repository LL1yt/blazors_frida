@using Blazorise

<div class="save-config-dialog">
    <TextEdit @bind-Text="@configName"
             Placeholder="Enter configuration name"
             Style="width: 100%; margin-bottom: 1rem;" />
    
    <div class="d-flex justify-content-end gap-2">
        <Button Color="Color.Light"
                Clicked="@OnCancel">
            Cancel
        </Button>
        <Button Color="Color.Primary"
                Clicked="@OnSave"
                Disabled="@string.IsNullOrWhiteSpace(configName)">
            Save
        </Button>
    </div>
</div>

@code {
    private string configName = "";

    [Parameter] public EventCallback<string> OnConfigSaved { get; set; }
    [Parameter] public EventCallback OnCanceled { get; set; }

    private Task OnCancel() => OnCanceled.InvokeAsync();
    private Task OnSave() => OnConfigSaved.InvokeAsync(configName);
}
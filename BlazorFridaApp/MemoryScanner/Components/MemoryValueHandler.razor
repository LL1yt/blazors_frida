@inherits MemoryScannerComponentBase

@inject IMemoryReaderService MemoryReader

@code {
    private Dictionary<IntPtr, int> currentValues = new();

    [Parameter]
    public MemoryValueType ValueType { get; set; }

    public async Task<byte[]> GetCurrentValue(IntPtr address)
    {
        try
        {
            if (ValueType == MemoryValueType.String || ValueType == MemoryValueType.Array)
            {
                ShowWarning("Unsupported type", $"Type {ValueType} is not supported yet");
                return Array.Empty<byte>();
            }

            int size = ValueType switch
            {
                MemoryValueType.Byte => 1,
                MemoryValueType.Short => 2,
                MemoryValueType.Int => 4,
                MemoryValueType.Float => 4,
                MemoryValueType.Long => 8,
                MemoryValueType.Double => 8,
                _ => throw new ArgumentException($"Unsupported value type: {ValueType}")
            };

            byte[] bytes;
            try
            {
                bytes = await MemoryReader.ReadMemoryBytes(address, size);
            }
            catch (Exception ex)
            {
                ShowError("Memory read error", $"Failed to read memory at {address:X}", ex);
                return Array.Empty<byte>();
            }
            
            return bytes;
        }
        catch (Exception ex)
        {
            ShowError("Unexpected error", "Error getting value", ex);
            return Array.Empty<byte>();
        }
    }

    public async Task OnValueChanged((IntPtr address, byte[] value) change)
    {
        try
        {
            await MemoryReader.WriteMemoryBytes(change.address, change.value);
            int computedValue = ValueType switch
            {
                MemoryValueType.Byte => change.value[0],
                MemoryValueType.Short => BitConverter.ToInt16(change.value, 0),
                MemoryValueType.Int => BitConverter.ToInt32(change.value, 0),
                MemoryValueType.Float => (int)BitConverter.ToSingle(change.value, 0),
                MemoryValueType.Long => (int)BitConverter.ToInt64(change.value, 0),
                MemoryValueType.Double => (int)BitConverter.ToDouble(change.value, 0),
                _ => 0
            };
            currentValues[change.address] = computedValue;
        }
        catch (Exception ex)
        {
            ShowError("Failed to write value", ex.Message, ex);
        }
    }

    public void ClearCache()
    {
        currentValues.Clear();
    }
}
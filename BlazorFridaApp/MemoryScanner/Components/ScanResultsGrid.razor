@using BlazorFridaApp.MemoryScanner.Models

<div class="scan-results">
    @if (Results != null && Results.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Address</th>
                        <th>Value</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Results)
                    {
                        <tr>
                            <td>@(result.Addresses.FirstOrDefault().ToString("X"))</td>
                            <td>@(BitConverter.ToString(result.Value))</td>
                            <td>@result.ValueType</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => OnFreezeClick.InvokeAsync(result)">
                                    <i class="fas fa-lock"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No scan results to display.
        </div>
    }
</div>

@code {
    [Parameter]
    public List<ScanResult> Results { get; set; } = new();

    [Parameter]
    public EventCallback<ScanResult> OnFreezeClick { get; set; }
}
@using BlazorFridaApp.MemoryScanner.Models
@using Radzen
@using Radzen.Blazor

<RadzenDataGrid Data="@Results" TItem="IntPtr">
    <Columns>
        <RadzenDataGridColumn TItem="IntPtr" Title="Address" Property="@nameof(IntPtr)" FormatString="X8"/>
        <RadzenDataGridColumn TItem="IntPtr" Title="Value">
            <Template>
                @{
                    var row = context;
                }
                @if (IsFrozen(row))
                {
                    <span>@FormatValue(row)</span>
                }
                else
                {
                    var currentValue = GetCurrentValue(row);
                    <div class="d-flex align-items-center">
                        <RadzenNumeric TValue="int" 
                                     Value="@currentValue"
                                     ValueChanged="@(async v => await HandleValueChange(row, v))" />
                        <span class="ms-2">@FormatValue(row)</span>
                    </div>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="IntPtr" Title="Actions">
            <Template>
                <RadzenButton Icon="lock" 
                            Click="@(() => OnFreezeToggle.InvokeAsync(context))" 
                            Disabled="@(IsFrozen(context))"/>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter] public required List<IntPtr> Results { get; set; }
    [Parameter] public required MemoryValueType ValueType { get; set; }
    [Parameter] public required Func<IntPtr, int> GetCurrentValue { get; set; }
    [Parameter] public required Func<IntPtr, bool> IsFrozen { get; set; }
    [Parameter] public EventCallback<(IntPtr address, int value)> OnValueChanged { get; set; }
    [Parameter] public EventCallback<IntPtr> OnFreezeToggle { get; set; }

    private string FormatValue(IntPtr value)
    {
        return ValueType switch
        {
            MemoryValueType.Float => ((float)GetCurrentValue(value)).ToString("F2"),
            MemoryValueType.Double => ((double)GetCurrentValue(value)).ToString("F2"),
            MemoryValueType.Byte => $"0x{GetCurrentValue(value):X2}",
            MemoryValueType.Int16 => GetCurrentValue(value).ToString(),
            MemoryValueType.Int32 => GetCurrentValue(value).ToString(),
            MemoryValueType.Int64 => GetCurrentValue(value).ToString(),
            _ => GetCurrentValue(value).ToString()
        };
    }
    private async Task HandleValueChange(IntPtr address, object newValue)
    {
        // Add null check and proper event invocation
        if (OnValueChanged.HasDelegate)
        {
            await OnValueChanged.InvokeAsync((address, (int)newValue));
        }
    }
}
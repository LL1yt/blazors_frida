@using System.Collections.Concurrent
@using System.Threading
@using System.Runtime.InteropServices
@inherits MemoryScannerComponentBase

@inject IValueFreezerService Freezer

<div class="freeze-control">
    <div class="d-flex align-items-center gap-2">
        <div class="input-group">
            <span class="input-group-text">0x</span>
            <input type="text" 
                   class="form-control font-monospace" 
                   placeholder="Address (hex)"
                   value="@addressInput"
                   @onchange="@(e => addressInput = e.Value?.ToString() ?? "")" />
        </div>
        <input type="number" 
               class="form-control" 
               placeholder="Value"
               value="@freezeValue" 
               @onchange="@(e => freezeValue = int.Parse(e.Value?.ToString() ?? "0"))" />
        <button class="btn btn-primary" 
                @onclick="@(() => OnFreezeClick())"
                disabled="@(!IsValidAddress)">
            Freeze
        </button>
    </div>
    @if (!IsValidAddress && !string.IsNullOrEmpty(addressInput))
    {
        <div class="text-danger small mt-1">Invalid address format</div>
    }

    @if (frozenAddresses?.Any() == true)
    {
        <div class="frozen-addresses mt-3">
            <h4 class="h5 mb-2">Frozen Addresses</h4>
            <ul class="list-unstyled">
                @foreach (var address in frozenAddresses)
                {
                    <li class="mb-1">
                        <span class="badge bg-secondary">@($"{address:X8}")</span>
                    </li>
                }
            </ul>
        </div>
    }
</div>

<style>
    .freeze-control {
        padding: 1rem;
        background-color: var(--bs-light);
        border-radius: 0.375rem;
    }

    .frozen-addresses {
        border-top: 1px solid var(--bs-border-color);
        padding-top: 1rem;
        margin-top: 1rem;
    }
</style>

@code {
    private readonly ConcurrentDictionary<IntPtr, CancellationTokenSource> _freezeOperations = new();
    private readonly SemaphoreSlim _freezeOperationLock = new(1, 1);
    private bool _disposed;
    private HashSet<IntPtr> frozenAddresses = new();
    private int freezeValue;
    private string addressInput = "";
    private bool IsValidAddress => !string.IsNullOrEmpty(addressInput) && 
                                 addressInput.All(c => "0123456789abcdefABCDEF".Contains(c)) &&
                                 addressInput.Length <= 16;

    [Parameter]
    public MemoryValueType ValueType { get; set; }

    [Parameter]
    public EventCallback<(IntPtr address, bool isFrozen)> OnFreezeStateChanged { get; set; }

    public bool IsFrozen(IntPtr address)
    {
        ObjectDisposedException.ThrowIf(_disposed, nameof(ValueFreezer));
        return frozenAddresses.Contains(address);
    }

    public async Task OnValueChanged(IntPtr address, byte[] bytes)
    {
        try
        {
            await Freezer.FreezeValue(address, bytes, ValueType.ToString());
            frozenAddresses.Add(address);
            await OnFreezeStateChanged.InvokeAsync((address, true));
        }
        catch (Exception ex)
        {
            ShowError("Failed to update frozen value", ex.Message, ex);
        }
    }

    public async Task UnfreezeValue(IntPtr address)
    {
        try
        {
            await Freezer.UnfreezeValue(address);
            frozenAddresses.Remove(address);
            await OnFreezeStateChanged.InvokeAsync((address, false));
        }
        catch (Exception ex)
        {
            ShowError("Failed to unfreeze value", ex.Message, ex);
        }
    }

    public async Task ToggleFreeze(IntPtr address, int value)
    {
        ObjectDisposedException.ThrowIf(_disposed, nameof(ValueFreezer));
        
        await _freezeOperationLock.WaitAsync();
        try
        {
            if (_freezeOperations.TryGetValue(address, out var existingCts))
            {
                // Cancel existing freeze
                existingCts.Cancel();
                await Task.Delay(100); // Give time for the operation to stop
                existingCts.Dispose();
                _freezeOperations.TryRemove(address, out _);
                await UnfreezeValue(address);
            }
            else
            {
                // Start new freeze
                var cts = new CancellationTokenSource();
                if (_freezeOperations.TryAdd(address, cts))
                {
                    _ = StartFreezeOperation(address, value, cts.Token);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling freeze state for address {Address:X}", address);
            throw;
        }
        finally
        {
            _freezeOperationLock.Release();
        }
    }

    private async Task StartFreezeOperation(IntPtr address, int value, CancellationToken cancellationToken)
    {
        try
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
            var valueBytes = BitConverter.GetBytes(value);

            while (!cancellationToken.IsCancellationRequested && await periodicTimer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await OnValueChanged(address, valueBytes);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Error during freeze operation for address {Address:X}", address);
                }
            }
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("Freeze operation cancelled for address {Address:X}", address);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Freeze operation failed for address {Address:X}", address);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Logger.LogInformation("ValueFreezer component initialized");
        frozenAddresses = await Freezer.GetFrozenAddresses();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && frozenAddresses.Any())
        {
            frozenAddresses = await Freezer.GetFrozenAddresses();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_disposed)
        {
            try
            {
                // Cancel all freeze operations
                foreach (var cts in _freezeOperations.Values)
                {
                    cts.Cancel();
                    await Task.Delay(100); // Give operations time to stop
                    cts.Dispose();
                }
                _freezeOperations.Clear();

                _freezeOperationLock.Dispose();
                _disposed = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error disposing ValueFreezer component");
            }
        }
    }

    private async Task OnFreezeClick()
    {
        try
        {
            if (!IsValidAddress)
            {
                ShowWarning("Invalid Address", "Please enter a valid hexadecimal address");
                return;
            }

            var address = new IntPtr(Convert.ToInt64(addressInput, 16));
            await ToggleFreeze(address, freezeValue);
            
            Logger.LogInformation("Manual freeze requested:\n" +
                "- Address: {Address:X}\n" +
                "- Value: {Value}",
                address.ToInt64(), freezeValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to freeze value:\n" +
                "- Address Input: {AddressInput}\n" +
                "- Value: {Value}",
                addressInput, freezeValue);
            ShowError("Freeze Failed", "Failed to freeze value at specified address", ex);
        }
    }
}
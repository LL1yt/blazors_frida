@inherits MemoryScannerComponentBase
@implements IAsyncDisposable

@inject IValueFreezerService Freezer

@code {
    private HashSet<IntPtr> frozenAddresses = new();

    [Parameter]
    public MemoryValueType ValueType { get; set; }

    public async Task OnValueChanged(IntPtr address, byte[] bytes)
    {
        try
        {
            await Freezer.FreezeValue(address, bytes, ValueType.ToString());
        }
        catch (Exception ex)
        {
            ShowError("Failed to update frozen value", ex.Message, ex);
        }
    }
}
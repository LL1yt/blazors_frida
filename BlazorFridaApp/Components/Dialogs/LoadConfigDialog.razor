@using BlazorFridaApp.MemoryScanner.Models

<div class="config-list">
    @if (Configs?.Any() != true)
    {
        <div>No saved configurations found.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var config in Configs)
            {
                <div class="list-group-item" @onclick="@(() => LoadConfig(config))">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div>@config.Name</div>
                            @if (!string.IsNullOrEmpty(config.Description))
                            {
                                <div class="text-muted">
                                    <small>@config.Description</small>
                                </div>
                            }
                        </div>
                        <button class="btn btn-primary btn-sm">Load</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="d-flex justify-content-end mt-3">
    <button class="btn btn-secondary" @onclick="OnCanceled">Cancel</button>
</div>

<style>
    .config-list {
        max-height: 300px;
        overflow-y: auto;
    }
</style>

@code {
    [Parameter]
    public List<ScannerConfig> Configs { get; set; } = new();

    [Parameter]
    public EventCallback<ScannerConfig> OnConfigSelected { get; set; }

    [Parameter]
    public EventCallback OnCanceled { get; set; }

    private async Task LoadConfig(ScannerConfig config)
    {
        await OnConfigSelected.InvokeAsync(config);
    }
}
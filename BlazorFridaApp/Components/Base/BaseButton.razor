@using Microsoft.AspNetCore.Components.Web

<button @ref="ButtonElement"
        type="@Type"
        class="btn @GetButtonClass() @Class"
        @onclick="OnClickHandler"
        disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="@Icon"></i>
    }
    @if (ChildContent != null)
    {
        <span class="@(Icon != null ? "ms-2" : "")">@ChildContent</span>
    }
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string Class { get; set; }
    [Parameter] public string Icon { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private ElementReference ButtonElement;

    private string GetButtonClass()
    {
        return $"btn-{Color}";
    }

    private async Task OnClickHandler(MouseEventArgs args)
    {
        if (OnClick.HasDelegate)
            await OnClick.InvokeAsync(args);
    }
} 
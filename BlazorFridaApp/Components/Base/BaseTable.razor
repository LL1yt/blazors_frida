@using System.ComponentModel.DataAnnotations

@typeparam TItem

<div class="table-responsive @WrapperClass">
    <table class="table @Class">
        <thead>
            <tr>@HeaderTemplate</tr>
        </thead>
        <tbody>
            @if (Items != null && Items.Any())
            {
                @foreach (var item in Items)
                {
                    <tr>@RowTemplate(item)</tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="@ColumnCount" class="text-center">@EmptyText</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, Required] public IEnumerable<TItem> Items { get; set; } = default!;
    [Parameter, Required] public RenderFragment HeaderTemplate { get; set; } = default!;
    [Parameter, Required] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public int ColumnCount { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No data available";
} 
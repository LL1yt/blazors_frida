@typeparam TValue
@using System.ComponentModel.DataAnnotations

<div class="form-group @WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="form-label">@Label</label>
    }
    <select @ref="SelectElement"
            id="@Id"
            class="form-select @Class"
            value="@CurrentValue"
            @onchange="OnChangeHandler"
            disabled="@Disabled">
        @if (!string.IsNullOrEmpty(Placeholder))
        {
            <option value="">@Placeholder</option>
        }
        @ChildContent
    </select>
    @if (ValidationFor != null)
    {
        <ValidationMessage For="ValidationFor" />
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValidationFor { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;

    private ElementReference SelectElement;
    private TValue CurrentValue
    {
        get => Value;
        set
        {
            if (!EqualityComparer<TValue>.Default.Equals(Value, value))
            {
                Value = value;
                _ = ValueChanged.InvokeAsync(value);
            }
        }
    }

    private void OnChangeHandler(ChangeEventArgs e)
    {
        if (e.Value == null) return;
        
        if (typeof(TValue) == typeof(string))
        {
            CurrentValue = (TValue)(object)(e.Value.ToString() ?? string.Empty);
        }
        else if (typeof(TValue).IsEnum)
        {
            var strValue = e.Value.ToString();
            if (strValue != null)
            {
                CurrentValue = (TValue)Enum.Parse(typeof(TValue), strValue);
            }
        }
        else if (typeof(TValue) == typeof(int))
        {
            var strValue = e.Value.ToString();
            if (strValue != null && int.TryParse(strValue, out var intValue))
            {
                CurrentValue = (TValue)(object)intValue;
            }
        }
    }
} 
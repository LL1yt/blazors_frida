@typeparam TValue

<div class="form-group @WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@Id" class="form-label">@Label</label>
    }
    <select @ref="SelectElement"
            id="@Id"
            class="form-select @Class"
            value="@CurrentValue"
            @onchange="OnChangeHandler"
            disabled="@Disabled">
        @if (!string.IsNullOrEmpty(Placeholder))
        {
            <option value="">@Placeholder</option>
        }
        @ChildContent
    </select>
    @if (ValidationFor != null)
    {
        <ValidationMessage For="ValidationFor" />
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string Label { get; set; }
    [Parameter] public string Class { get; set; }
    [Parameter] public string WrapperClass { get; set; }
    [Parameter] public TValue Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Expression<Func<TValue>> ValidationFor { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; }

    private ElementReference SelectElement;
    private TValue CurrentValue
    {
        get => Value;
        set
        {
            if (!EqualityComparer<TValue>.Default.Equals(Value, value))
            {
                Value = value;
                _ = ValueChanged.InvokeAsync(value);
            }
        }
    }

    private async Task OnChangeHandler(ChangeEventArgs e)
    {
        if (typeof(TValue) == typeof(string))
        {
            CurrentValue = (TValue)e.Value;
        }
        else if (typeof(TValue).IsEnum)
        {
            CurrentValue = (TValue)Enum.Parse(typeof(TValue), e.Value.ToString());
        }
        else if (typeof(TValue) == typeof(int))
        {
            CurrentValue = (TValue)(object)int.Parse(e.Value.ToString());
        }
    }
} 
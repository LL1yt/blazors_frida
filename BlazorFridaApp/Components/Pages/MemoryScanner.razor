@page "/memory-scanner"
@using BlazorFridaApp.MemoryScanner.Models
@using BlazorFridaApp.MemoryScanner.Components
@using BlazorFridaApp.MemoryScanner.Services.Interfaces
@using BlazorFridaApp.Services
@using Blazorise
@using Blazorise.Components
@using Blazorise.Icons.FontAwesome
@using Blazorise.Icons
@using Blazorise.Modules
@using static Blazorise.ModalSize
@using System.ComponentModel
@inherits MemoryScannerComponentBase

[Inject]
protected new IScanProfileService ProfileService { get; set; } = default!;
[Inject]
protected new INotificationService NotificationService { get; set; } = default!;
@inject DialogService DialogService

<div class="memory-scanner-container">
    <Card Margin="Margin.Is3.FromBottom">
        <CardBody>
            <div class="d-flex justify-content-between align-items-center">
                <Heading Size="HeadingSize.Is2">Memory Scanner</Heading>
                <Addons>
                    <Button Color="Color.Secondary" Clicked="@HandleSaveConfigClick">
                        <Blazorise.Icon Name="@FontAwesomeIcons.Save" />
                        Save Config
                    </Button>
                    <Button Color="Color.Secondary" Clicked="@HandleLoadConfigClick">
                        <Blazorise.Icon Name="@FontAwesomeIcons.FolderOpen" />
                        Load Config
                    </Button>
                </Addons>
            </div>
        </CardBody>
    </Card>

    <div class="scanner-content">
        <div class="scanner-controls">
            <Card Margin="Margin.Is3.FromBottom">
                <CardBody>
                    <ProcessSelector
                        ProcessList="@_state.ProcessList"
                        SelectedProcessId="@_state.SelectedProcessId"
                        OnProcessSelected="@OnProcessSelected"
                        OnRefreshClick="@RefreshProcessList"
                        IsLoading="@_state.IsLoading" />
                </CardBody>
            </Card>

            <Card Margin="Margin.Is3.FromBottom" Class="scan-options-card">
                <CardBody>
                    <ScanControls
                        ScanType="@_state.SelectedScanType"
                        ValueType="@_state.SelectedValueType"
                        ScanTypes="@_state.ScanTypes"
                        ValueTypes="@_state.ValueTypes"
                        PatternHex="@_state.PatternHex"
                        Mask="@_state.Mask"
                        @bind-SearchValue="@_state.SearchValue"
                        IsFirstScan="@_state.IsFirstScan"
                        IsLoading="@_state.IsLoading"
                        CanScan="@_state.CanScan"
                        OnScanTypeChanged="@OnScanTypeChanged"
                        OnValueTypeChanged="@OnValueTypeChanged"
                        OnScanClick="@OnScan" />

                    <ScanExecutor @ref="scanExecutor"
                        ProcessId="@_state.SelectedProcessId"
                        ScanType="@_state.SelectedScanType"
                        ValueType="@_state.SelectedValueType"
                        PatternHex="@_state.PatternHex"
                        Mask="@_state.Mask"
                        SearchValue="@_state.SearchValue"
                        IsFirstScan="@_state.IsFirstScan"
                        IsLoading="@_state.IsLoading"
                        OnScanComplete="@OnScanComplete"
                        OnLoadingChanged="@OnLoadingChanged" />
                </CardBody>
            </Card>

            <Card Margin="Margin.Is3.FromBottom">
                <CardBody>
                    <Row>
                        <Column>
                            <MemoryValueHandler @ref="valueHandler"
                                ValueType="@_state.SelectedValueType" />
                        </Column>
                        <Column>
                            <ValueFreezer @ref="valueFreezer"
                                ValueType="@_state.SelectedValueType" />
                        </Column>
                    </Row>
                </CardBody>
            </Card>
        </div>

        <Card>
            <CardBody>
                <ScanResultsGrid
                    Results="@_state.ScanResults"
                    ValueType="@_state.SelectedValueType"
                    GetCurrentValue="@(addr => BitConverter.ToInt32(GetCurrentValue(addr).Result, 0))"
                    IsFrozen="@IsFrozen"
                    OnValueChanged="@(args => OnValueChanged(args.address, BitConverter.GetBytes(args.value)))"
                    OnFreezeToggle="@(addr => ToggleFreeze(addr, GetDefaultValueBytes(_state.SelectedValueType)))" />
            </CardBody>
        </Card>
    </div>
</div>

<Modal @ref="_saveConfigModal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Save Configuration</ModalTitle>
        </ModalHeader>
        <ModalBody>
            <SaveConfigDialog 
                OnConfigSaved="@HandleConfigSaved"
                OnCanceled="@(() => _saveConfigModal?.Hide())" />
        </ModalBody>
    </ModalContent>
</Modal>

<Modal @ref="_loadConfigModal">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>Load Configuration</ModalTitle>
        </ModalHeader>
        <ModalBody>
            <LoadConfigDialog 
                Configs="@(_state.SavedConfigs ?? new())"
                OnConfigSelected="@HandleConfigLoaded"
                OnCanceled="@(() => _loadConfigModal?.Hide())" />
        </ModalBody>
    </ModalContent>
</Modal>

<style>
    .memory-scanner-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .header-card {
        margin-bottom: 0;
    }

    .scanner-content {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 1rem;
        height: calc(100vh - 200px);
    }

    .scanner-controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .process-card {
        margin-bottom: 0;
    }

    .scan-options-card {
        margin-bottom: 0;
        flex-grow: 1;
    }

    .value-handlers-card {
        margin-bottom: 0;
    }

    .results-card {
        margin-bottom: 0;
        height: 100%;
        overflow: auto;
    }
</style>

@code {
    private Modal? _saveConfigModal;
    private Modal? _loadConfigModal;
    
    private async Task HandleSaveConfigClick()
    {
        if (_saveConfigModal is not null)
            await _saveConfigModal.Show();
    }

    private async Task HandleLoadConfigClick()
    {
        if (_loadConfigModal is not null)
            await _loadConfigModal.Show();
    }

    private async Task HandleConfigSaved(string configName)
    {
        if (string.IsNullOrWhiteSpace(configName))
            return;

        try 
        {
            var config = _state.ToConfig();
            config.Name = configName;
            config.Description = $"Configuration saved at {DateTime.Now}";
            
            await ProfileService.SaveScannerConfig(configName, config);
            _saveConfigModal?.Hide();
            NotificationService.ShowSuccess("Configuration saved", $"Configuration '{configName}' saved successfully");
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Save failed", $"Failed to save configuration: {ex.Message}");
        }
    }

    private Task HandleConfigLoaded(ScannerConfig config)
    {
        if (config == null)
            return Task.CompletedTask;

        try
        {
            _state.LoadConfig(config);
            _loadConfigModal?.Hide();
            NotificationService.ShowSuccess("Configuration loaded", "Configuration loaded successfully");
            return Task.CompletedTask;
        }
        catch (Exception ex)
        {
            NotificationService.ShowError("Load failed", $"Failed to load configuration: {ex.Message}");
            return Task.CompletedTask;
        }
    }
}

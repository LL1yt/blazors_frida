@page "/memory-scanner"
@using BlazorFridaApp.MemoryScanner
@using BlazorFridaApp.Persistence
@using Radzen
@using Radzen.Blazor
@inject ProcessMemoryScanner Scanner
@inject AppDbContext DbContext
@inject NotificationService NotificationService

<PageTitle>Memory Scanner</PageTitle>

<RadzenNotification />

<RadzenCard class="rz-my-4">
    <RadzenText TextStyle="TextStyle.H3">Memory Scanner</RadzenText>
    
    <div class="row">
        <div class="col-md-4">
            <RadzenLabel Text="Select Process" />
            <RadzenDropDown @bind-Value="selectedProcessId"
                          Data="@processes"
                          TextProperty="ProcessName"
                          ValueProperty="Id"
                          Placeholder="-- Select Process --"
                          Class="w-100" />
        </div>
        
        <div class="col-md-4">
            <RadzenLabel Text="Pattern (hex bytes)" />
            <RadzenTextBox @bind-Value="patternInput"
                         Placeholder="00 AA FF ??"
                         Class="w-100" />
        </div>
        
        <div class="col-md-4">
            <RadzenLabel Text="Mask" />
            <RadzenTextBox @bind-Value="mask"
                         Placeholder="xx??xx"
                         Class="w-100" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col">
            <RadzenButton Click="@ScanMemory"
                         Text="@(isScanning ? "Scanning..." : "Scan Memory")"
                         ButtonStyle="ButtonStyle.Primary"
                         IsBusy="@isScanning"
                         Disabled="@isScanning"
                         Class="w-100" />
        </div>
    </div>
</RadzenCard>

@if (scanResults.Any())
{
    <RadzenCard class="rz-my-4">
        <RadzenText TextStyle="TextStyle.H4">Scan Results</RadzenText>
        
        <RadzenDataGrid Data="@scanResults" TItem="ScanResult" AllowPaging="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="ScanResult" Title="Address" 
                                    Property="Address" FormatString="0x{0:X}" />
                                    
                <RadzenDataGridColumn TItem="ScanResult" Title="Current Value">
                    <Template Context="result">
                        @BitConverter.ToString(result.CurrentValue)
                    </Template>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn TItem="ScanResult" Title="New Value">
                    <Template Context="result">
                        <RadzenTextBox @bind-Value="result.NewValue"
                                     Placeholder="Hex bytes"
                                     Class="w-100" />
                    </Template>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn TItem="ScanResult" Title="Actions">
                    <Template Context="result">
                        <RadzenButton Click="@(() => FreezeAddress(result))"
                                    ButtonStyle="@(result.IsFrozen ? ButtonStyle.Success : ButtonStyle.Light)"
                                    Text="@(result.IsFrozen ? "Frozen" : "Freeze")"
                                    Size="ButtonSize.Small" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private int selectedProcessId;
    private string patternInput = "";
    private string mask = "";
    private bool isScanning;
    private List<ScanResult> scanResults = new();
    private System.Diagnostics.Process[] processes = Array.Empty<System.Diagnostics.Process>();

    protected override void OnInitialized()
    {
        processes = System.Diagnostics.Process.GetProcesses()
            .OrderBy(p => p.ProcessName)
            .ToArray();
    }

    class ScanResult
    {
        public nint Address { get; set; }
        public byte[] CurrentValue { get; set; } = Array.Empty<byte>();
        public string NewValue { get; set; } = "";
        public bool IsFrozen { get; set; }
    }

    private async Task ScanMemory()
    {
        if (selectedProcessId == 0)
        {
            await NotificationService.Show(new NotificationMessage { 
                Severity = NotificationSeverity.Warning,
                Summary = "Warning",
                Detail = "Please select a process first.",
                Duration = 4000
            });
            return;
        }

        if (string.IsNullOrWhiteSpace(patternInput))
        {
            await NotificationService.Show(new NotificationMessage { 
                Severity = NotificationSeverity.Warning,
                Summary = "Warning",
                Detail = "Please enter a pattern to search for.",
                Duration = 4000
            });
            return;
        }
        
        isScanning = true;
        try
        {
            var pattern = ParseHexPattern(patternInput);
            var addresses = await Scanner.ScanForPattern(selectedProcessId, pattern, mask);
            
            scanResults = addresses.Select(a => new ScanResult {
                Address = a,
                CurrentValue = ReadAddressValue(a)
            }).ToList();

            if (!scanResults.Any())
            {
                await NotificationService.Show(new NotificationMessage { 
                    Severity = NotificationSeverity.Info,
                    Summary = "Info",
                    Detail = "No matches found for the given pattern.",
                    Duration = 4000
                });
            }
            else
            {
                await NotificationService.Show(new NotificationMessage { 
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = $"Found {scanResults.Count} matches.",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Show(new NotificationMessage { 
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to scan memory: {ex.Message}",
                Duration = 4000
            });
        }
        finally
        {
            isScanning = false;
        }
    }

    private byte[] ParseHexPattern(string input)
    {
        return input.Split(' ')
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Select(p => p == "?" ? (byte)0 : Convert.ToByte(p, 16))
            .ToArray();
    }

    private byte[] ReadAddressValue(nint address)
    {
        var buffer = new byte[4];
        ProcessMemoryScanner.ReadProcessMemory(Scanner.ProcessHandle, address, buffer, buffer.Length, out _);
        return buffer;
    }

    private async Task FreezeAddress(ScanResult result)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(result.NewValue))
            {
                await NotificationService.Show(new NotificationMessage { 
                    Severity = NotificationSeverity.Warning,
                    Summary = "Warning",
                    Detail = "Please enter a new value first.",
                    Duration = 4000
                });
                return;
            }

            var bytes = ParseHexPattern(result.NewValue);
            await Scanner.WriteMemory(result.Address, bytes);
            result.IsFrozen = true;
            result.CurrentValue = bytes;
            
            await NotificationService.Show(new NotificationMessage { 
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"Value at address 0x{result.Address:X} has been {(result.IsFrozen ? "frozen" : "unfrozen")}.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            await NotificationService.Show(new NotificationMessage { 
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to {(result.IsFrozen ? "freeze" : "unfreeze")} address: {ex.Message}",
                Duration = 4000
            });
        }
    }
}

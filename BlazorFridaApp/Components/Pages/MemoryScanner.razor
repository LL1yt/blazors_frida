@page "/memory-scanner"
@using BlazorFridaApp.MemoryScanner.Components
@inherits MemoryScannerComponentBase
@implements IAsyncDisposable

@inject DialogService DialogService

@code {
    [Inject]
    private new ILogger<MemoryScanner> Logger { get; set; } = default!;

    private MemoryScannerState _state = new();
}

<div class="memory-scanner-container">
    <RadzenCard class="header-card">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Memory Scanner</h2>
            <div class="d-flex gap-2">
                <RadzenButton Icon="save" Text="Save Config" ButtonStyle="ButtonStyle.Secondary" Click="@SaveConfig" />
                <RadzenButton Icon="folder_open" Text="Load Config" ButtonStyle="ButtonStyle.Secondary" Click="@LoadConfig" />
            </div>
        </div>
    </RadzenCard>

    <div class="scanner-content">
        <div class="scanner-controls">
            <RadzenCard class="process-card">
                <ProcessSelector
                    ProcessList="@_state.ProcessList"
                    SelectedProcessId="@_state.SelectedProcessId"
                    OnProcessSelected="@OnProcessSelected"
                    OnRefreshClick="@RefreshProcessList"
                    IsLoading="@_state.IsLoading" />
            </RadzenCard>

            <RadzenCard class="scan-options-card">
                <ScanControls
                    ScanType="@_state.SelectedScanType"
                    ValueType="@_state.SelectedValueType"
                    ScanTypes="@_state.ScanTypes"
                    ValueTypes="@_state.ValueTypes"
                    PatternHex="@_state.PatternHex"
                    Mask="@_state.Mask"
                    @bind-SearchValue="@_state.SearchValue"
                    IsFirstScan="@_state.IsFirstScan"
                    IsLoading="@_state.IsLoading"
                    CanScan="@_state.CanScan"
                    OnScanTypeChanged="@OnScanTypeChanged"
                    OnValueTypeChanged="@OnValueTypeChanged"
                    OnScanClick="@OnScan" />

                <ScanExecutor @ref="scanExecutor"
                    ProcessId="@_state.SelectedProcessId"
                    ScanType="@_state.SelectedScanType"
                    ValueType="@_state.SelectedValueType"
                    PatternHex="@_state.PatternHex"
                    Mask="@_state.Mask"
                    SearchValue="@_state.SearchValue"
                    IsFirstScan="@_state.IsFirstScan"
                    IsLoading="@_state.IsLoading"
                    OnScanComplete="@OnScanComplete"
                    OnLoadingChanged="@OnLoadingChanged" />
            </RadzenCard>

            <RadzenCard class="value-handlers-card">
                <div class="d-flex gap-2">
                    <div class="flex-grow-1">
                        <MemoryValueHandler @ref="valueHandler"
                            ValueType="@_state.SelectedValueType" />
                    </div>
                    <div class="flex-grow-1">
                        <ValueFreezer @ref="valueFreezer"
                            ValueType="@_state.SelectedValueType" />
                    </div>
                </div>
            </RadzenCard>
        </div>

        <RadzenCard class="results-card">
            <ScanResultsGrid
                Results="@_state.ScanResults"
                ValueType="@_state.SelectedValueType"
                GetCurrentValue="@GetCurrentValue"
                IsFrozen="@IsFrozen"
                OnValueChanged="@OnValueChanged"
                OnFreezeToggle="@ToggleFreeze" />
        </RadzenCard>
    </div>
</div>

<style>
    .memory-scanner-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .header-card {
        margin-bottom: 0;
    }

    .scanner-content {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 1rem;
        height: calc(100vh - 200px);
    }

    .scanner-controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .process-card {
        margin-bottom: 0;
    }

    .scan-options-card {
        margin-bottom: 0;
        flex-grow: 1;
    }

    .value-handlers-card {
        margin-bottom: 0;
    }

    .results-card {
        margin-bottom: 0;
        height: 100%;
        overflow: auto;
    }
</style>

@code {
    private ScanExecutor scanExecutor = default!;
    private MemoryValueHandler valueHandler = default!;
    private ValueFreezer valueFreezer = default!;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Initializing MemoryScanner component");
        await base.OnInitializedAsync();
    }

    private async Task RefreshProcessList()
    {
        Logger.LogInformation("Starting process list refresh");
        _state.IsLoading = true;
        StateHasChanged();
        
        try
        {
            Logger.LogDebug("Calling ScannerService.RefreshProcessList");
            await ScannerService.RefreshProcessList(_state);
            Logger.LogInformation("Process list refreshed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh process list");
            throw;
        }
        finally
        {
            _state.IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnProcessSelected()
    {
        try
        {
            Logger.LogInformation("Process selected: ID {ProcessId}", _state.SelectedProcessId);
            await ScannerService.OnProcessSelected(_state);
            Logger.LogDebug("Process selection handled successfully");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling process selection for ID {ProcessId}", _state.SelectedProcessId);
            throw;
        }
    }

    private async Task OnScanTypeChanged(ScanType newType)
    {
        try
        {
            Logger.LogInformation("Scan type changing from {OldType} to {NewType}",
                _state.SelectedScanType, newType);
            await ScannerService.OnScanTypeChanged(_state, newType);
            Logger.LogDebug("Scan type changed successfully");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing scan type to {NewType}", newType);
            throw;
        }
    }

    private void OnValueTypeChanged(MemoryValueType newType)
    {
        try
        {
            Logger.LogInformation("Value type changing from {OldType} to {NewType}",
                _state.SelectedValueType, newType);
            ScannerService.OnValueTypeChanged(_state, newType);
            Logger.LogDebug("Value type changed successfully");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing value type to {NewType}", newType);
            throw;
        }
    }

    private async Task OnScan()
    {
        if (!_state.CanScan)
        {
            Logger.LogWarning("Scan attempted but CanScan is false");
            return;
        }

        try
        {
            Logger.LogInformation("Starting memory scan");
            await scanExecutor.ExecuteScan(valueHandler.GetCurrentValue);
            Logger.LogDebug("Scan execution initiated successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing memory scan");
            throw;
        }
    }

    private void OnScanComplete(List<IntPtr> results)
    {
        try
        {
            Logger.LogInformation("Scan completed with {Count} results", results.Count);
            _state.OnScanComplete(results);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling scan completion");
            throw;
        }
    }

    private void OnLoadingChanged(bool isLoading)
    {
        _state.IsLoading = isLoading;
        StateHasChanged();
    }

    private async Task SaveConfig()
    {
        try
        {
            Logger.LogInformation("Saving scan configuration");
            // TODO: Implement configuration saving
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving scan configuration");
            throw;
        }
    }

    private async Task LoadConfig()
    {
        try
        {
            Logger.LogInformation("Loading scan configuration");
            // TODO: Implement configuration loading
            await Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading scan configuration");
            throw;
        }
    }

    private async Task<byte[]?> GetCurrentValue(nint address)
    {
        try
        {
            return await valueHandler.GetCurrentValue(address);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error getting current value at address {Address:X}", address);
            throw;
        }
    }

    private bool IsFrozen(nint address)
    {
        try
        {
            return valueFreezer.IsFrozen(address);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking freeze state for address {Address:X}", address);
            throw;
        }
    }

    private async Task OnValueChanged(nint address, byte[] newValue)
    {
        try
        {
            await valueHandler.OnValueChanged(address, newValue);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling value change at address {Address:X}", address);
            throw;
        }
    }

    private async Task ToggleFreeze(nint address, byte[] value)
    {
        try
        {
            await valueFreezer.ToggleFreeze(address, value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling freeze state for address {Address:X}", address);
            throw;
        }
    }

    public override async ValueTask DisposeAsync()
    {
        try
        {
            Logger.LogInformation("Disposing MemoryScanner component");
            if (valueFreezer != null)
            {
                await valueFreezer.DisposeAsync();
            }
            await base.DisposeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error disposing MemoryScanner component");
            throw;
        }
    }
}

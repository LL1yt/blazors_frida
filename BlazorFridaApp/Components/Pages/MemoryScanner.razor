@page "/memory-scanner"
@using BlazorFridaApp.MemoryScanner
@using BlazorFridaApp.Persistence
@using Radzen
@using Radzen.Blazor
@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject ProcessMemoryScanner Scanner
@inject AppDbContext DbContext
@inject NotificationService NotificationService

<PageTitle>Memory Scanner</PageTitle>

<RadzenNotification />

<RadzenCard class="rz-my-4">
    <RadzenText TextStyle="TextStyle.H3">Memory Scanner</RadzenText>
    
    <div class="row">
        <div class="col-md-4">
            <RadzenLabel Text="Select Process" />
            <RadzenDropDown @bind-Value="selectedProcessId"
                          Data="@processes"
                          TextProperty="ProcessName"
                          ValueProperty="Id"
                          Placeholder="-- Select Process --"
                          Change="@OnProcessChanged"
                          Class="w-100" />
        </div>
        
        <div class="col-md-4">
            <RadzenLabel Text="Pattern (hex bytes)" />
            <RadzenTextBox @bind-Value="patternInput"
                         Placeholder="00 AA FF ??"
                         Class="w-100" />
        </div>
        
        <div class="col-md-4">
            <RadzenLabel Text="Mask" />
            <RadzenTextBox @bind-Value="mask"
                         Placeholder="xx??xx"
                         Class="w-100" />
        </div>
    </div>

    <div class="row mt-3">
        <div class="col">
            <RadzenButton Click="@ScanMemory"
                         Text="@(isScanning ? "Scanning..." : "Scan Memory")"
                         ButtonStyle="ButtonStyle.Primary"
                         IsBusy="@isScanning"
                         Disabled="@isScanning"
                         Class="w-100" />
        </div>
    </div>
</RadzenCard>

@if (scanResults.Any())
{
    <RadzenCard class="rz-my-4">
        <RadzenText TextStyle="TextStyle.H4">Scan Results</RadzenText>
        
        <RadzenDataGrid Data="@scanResults" TItem="ScanResult" AllowPaging="true" PageSize="10">
            <Columns>
                <RadzenDataGridColumn TItem="ScanResult" Title="Address" 
                                    Property="Address" FormatString="0x{0:X}" />
                                    
                <RadzenDataGridColumn TItem="ScanResult" Title="Original Value">
                    <Template Context="result">
                        @BitConverter.ToString(result.OriginalValue)
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ScanResult" Title="Current Value">
                    <Template Context="result">
                        <span style="@(result.IsFrozen ? "color: #28a745;" : "")">
                            @BitConverter.ToString(result.CurrentValue)
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn TItem="ScanResult" Title="New Value">
                    <Template Context="result">
                        <RadzenTextBox @bind-Value="result.NewValue"
                                     Placeholder="Hex bytes (e.g., 00 FF AA)"
                                     Disabled="@result.IsFrozen"
                                     Class="w-100" />
                    </Template>
                </RadzenDataGridColumn>
                
                <RadzenDataGridColumn TItem="ScanResult" Title="Actions">
                    <Template Context="result">
                        <div class="d-flex gap-2">
                            <RadzenButton Click="@(() => FreezeAddress(result))"
                                        ButtonStyle="@(result.IsFrozen ? ButtonStyle.Success : ButtonStyle.Light)"
                                        Text="@(result.IsFrozen ? "Unfreeze" : "Freeze")"
                                        Size="ButtonSize.Small" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@code {
    private int selectedProcessId;
    private string patternInput = "";
    private string mask = "";
    private bool isScanning;
    private List<ScanResult> scanResults = new();
    private System.Diagnostics.Process[] processes = Array.Empty<System.Diagnostics.Process>();

    protected override async Task OnInitializedAsync()
    {
        processes = System.Diagnostics.Process.GetProcesses()
            .Where(p => !string.IsNullOrEmpty(p.ProcessName))
            .OrderBy(p => p.ProcessName)
            .ToArray();

        // Load last used process
        var lastProcessId = await Scanner.GetLastProcessId();
        if (lastProcessId.HasValue && processes.Any(p => p.Id == lastProcessId.Value))
        {
            selectedProcessId = lastProcessId.Value;
            await OnProcessChanged(selectedProcessId);
        }
    }

    class ScanResult
    {
        public nint Address { get; set; }
        public byte[] CurrentValue { get; set; } = Array.Empty<byte>();
        public byte[] OriginalValue { get; set; } = Array.Empty<byte>();
        public string NewValue { get; set; } = "";
        public bool IsFrozen { get; set; }
    }

    private async Task OnProcessChanged(object value)
    {
        if (value != null && int.TryParse(value.ToString(), out int processId))
        {
            // Clear previous results
            scanResults.Clear();
            
            try
            {
                await Scanner.SaveLastProcess(processId);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "Process Changed",
                    Detail = $"Selected process: {processes.FirstOrDefault(p => p.Id == processId)?.ProcessName}",
                    Duration = 4000
                });
            }
            catch (Exception ex)
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Error",
                    Detail = $"Failed to change process: {ex.Message}",
                    Duration = 4000
                });
            }
        }
    }

    private async Task ScanMemory()
    {
        if (selectedProcessId == 0)
        {
            NotificationService.Notify(new NotificationMessage { 
                Severity = NotificationSeverity.Warning,
                Summary = "Warning",
                Detail = "Please select a process first.",
                Duration = 4000
            });
            return;
        }

        if (string.IsNullOrWhiteSpace(patternInput))
        {
            NotificationService.Notify(new NotificationMessage { 
                Severity = NotificationSeverity.Warning,
                Summary = "Warning",
                Detail = "Please enter a pattern to search for.",
                Duration = 4000
            });
            return;
        }
        
        isScanning = true;
        try
        {
            var pattern = ParseHexPattern(patternInput);
            var addresses = await Scanner.ScanForPattern(selectedProcessId, pattern, mask);
            
            scanResults = new List<ScanResult>();
            foreach (var address in addresses)
            {
                var value = await ReadAddressValue(address);
                var lockedAddress = await DbContext.LockedAddresses
                    .FirstOrDefaultAsync(la => la.Address == (long)address);

                scanResults.Add(new ScanResult
                {
                    Address = address,
                    CurrentValue = value,
                    OriginalValue = lockedAddress?.OriginalBytes ?? value,
                    IsFrozen = lockedAddress?.IsFrozen ?? false,
                    NewValue = lockedAddress?.CurrentValue != null ?
                        BitConverter.ToString(lockedAddress.CurrentValue).Replace("-", " ") : ""
                });
            }

            // Start periodic refresh for frozen values
            _ = Task.Run(async () =>
            {
                while (scanResults.Any(r => r.IsFrozen))
                {
                    await Task.Delay(500); // Refresh every 500ms
                    await InvokeAsync(async () =>
                    {
                        foreach (var result in scanResults.Where(r => r.IsFrozen))
                        {
                            result.CurrentValue = await ReadAddressValue(result.Address);
                            StateHasChanged();
                        }
                    });
                }
            });

            if (!scanResults.Any())
            {
                NotificationService.Notify(new NotificationMessage { 
                    Severity = NotificationSeverity.Info,
                    Summary = "Info",
                    Detail = "No matches found for the given pattern.",
                    Duration = 4000
                });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage { 
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = $"Found {scanResults.Count} matches.",
                    Duration = 4000
                });
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage { 
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to scan memory: {ex.Message}",
                Duration = 4000
            });
        }
        finally
        {
            isScanning = false;
        }
    }

    private byte[] ParseHexPattern(string input)
    {
        return input.Split(' ')
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .Select(p => p == "?" ? (byte)0 : Convert.ToByte(p, 16))
            .ToArray();
    }

    private async Task<byte[]> ReadAddressValue(nint address)
    {
        try
        {
            return await Scanner.ReadMemoryBytes(address, 4);
        }
        catch (Exception)
        {
            return Array.Empty<byte>();
        }
    }

    private async Task FreezeAddress(ScanResult result)
    {
        try
        {
            if (result.IsFrozen)
            {
                await Scanner.UnfreezeValue(result.Address);
                result.IsFrozen = false;
                NotificationService.Notify(new NotificationMessage {
                    Severity = NotificationSeverity.Success,
                    Summary = "Success",
                    Detail = $"Value at address 0x{result.Address:X} has been unfrozen.",
                    Duration = 4000
                });
                return;
            }

            if (string.IsNullOrWhiteSpace(result.NewValue))
            {
                NotificationService.Notify(new NotificationMessage {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Warning",
                    Detail = "Please enter a new value first.",
                    Duration = 4000
                });
                return;
            }

            var bytes = ParseHexPattern(result.NewValue);
            await Scanner.FreezeValue(result.Address, bytes);
            result.IsFrozen = true;
            result.CurrentValue = bytes;
            
            NotificationService.Notify(new NotificationMessage {
                Severity = NotificationSeverity.Success,
                Summary = "Success",
                Detail = $"Value at address 0x{result.Address:X} has been frozen.",
                Duration = 4000
            });
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage {
                Severity = NotificationSeverity.Error,
                Summary = "Error",
                Detail = $"Failed to {(result.IsFrozen ? "freeze" : "unfreeze")} address: {ex.Message}",
                Duration = 4000
            });
        }
    }

    public void Dispose()
    {
        Scanner.Dispose();
    }
}

@page "/memory-scanner"
@using BlazorFridaApp.MemoryScanner.Components
@inherits MemoryScannerComponentBase
@implements IAsyncDisposable

@inject IProcessService ProcessService
@inject IScanProfileService ProfileService
@inject DialogService DialogService
@code {
    [Inject]
    private new ILogger<MemoryScanner> Logger { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Initializing MemoryScanner component");
        try
        {
            await base.OnInitializedAsync();
            Logger.LogInformation("MemoryScanner component initialized successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to initialize MemoryScanner component");
            throw;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Logger.LogInformation("MemoryScanner first render, refreshing process list");
            await RefreshProcessList();
        }
    }
}


<div class="memory-scanner-container">
    <RadzenCard class="header-card">
        <div class="d-flex justify-content-between align-items-center">
            <h2>Memory Scanner</h2>
            <div class="d-flex gap-2">
                <RadzenButton Icon="save" Text="Save Config" ButtonStyle="ButtonStyle.Secondary" Click="@SaveConfig" />
                <RadzenButton Icon="folder_open" Text="Load Config" ButtonStyle="ButtonStyle.Secondary" Click="@LoadConfig" />
            </div>
        </div>
    </RadzenCard>

    <div class="scanner-content">
        <div class="scanner-controls">
            <RadzenCard class="process-card">
                <ProcessSelector
                    ProcessList="@_state.ProcessList"
                    SelectedProcessId="@_state.SelectedProcessId"
                    OnProcessSelected="@OnProcessSelected"
                    OnRefreshClick="@RefreshProcessList"
                    IsLoading="@_state.IsLoading" />
            </RadzenCard>

            <RadzenCard class="scan-options-card">
                <ScanControls
                    ScanType="@_state.SelectedScanType"
                    ValueType="@_state.SelectedValueType"
                    ScanTypes="@_state.ScanTypes"
                    ValueTypes="@_state.ValueTypes"
                    PatternHex="@_state.PatternHex"
                    Mask="@_state.Mask"
                    @bind-SearchValue="@_state.SearchValue"
                    IsFirstScan="@_state.IsFirstScan"
                    IsLoading="@_state.IsLoading"
                    CanScan="@_state.CanScan"
                    OnScanTypeChanged="@OnScanTypeChanged"
                    OnValueTypeChanged="@OnValueTypeChanged"
                    OnScanClick="@OnScan" />

                <ScanExecutor @ref="scanExecutor"
                    ProcessId="@_state.SelectedProcessId"
                    ScanType="@_state.SelectedScanType"
                    ValueType="@_state.SelectedValueType"
                    PatternHex="@_state.PatternHex"
                    Mask="@_state.Mask"
                    SearchValue="@_state.SearchValue"
                    IsFirstScan="@_state.IsFirstScan"
                    IsLoading="@_state.IsLoading"
                    OnScanComplete="@OnScanComplete"
                    OnLoadingChanged="@OnLoadingChanged" />
            </RadzenCard>

            <RadzenCard class="value-handlers-card">
                <div class="d-flex gap-2">
                    <div class="flex-grow-1">
                        <MemoryValueHandler @ref="valueHandler"
                            ValueType="@_state.SelectedValueType" />
                    </div>
                    <div class="flex-grow-1">
                        <ValueFreezer @ref="valueFreezer"
                            ValueType="@_state.SelectedValueType" />
                    </div>
                </div>
            </RadzenCard>
        </div>

        <RadzenCard class="results-card">
            <ScanResultsGrid
                Results="@_state.ScanResults"
                ValueType="@_state.SelectedValueType"
                GetCurrentValue="@GetCurrentValue"
                IsFrozen="@IsFrozen"
                OnValueChanged="@OnValueChanged"
                OnFreezeToggle="@ToggleFreeze" />
        </RadzenCard>
    </div>
</div>

<style>
    .memory-scanner-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .header-card {
        margin-bottom: 0;
    }

    .scanner-content {
        display: grid;
        grid-template-columns: 400px 1fr;
        gap: 1rem;
        height: calc(100vh - 200px);
    }

    .scanner-controls {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        height: 100%;
    }

    .process-card {
        margin-bottom: 0;
    }

    .scan-options-card {
        margin-bottom: 0;
        flex-grow: 1;
    }

    .value-handlers-card {
        margin-bottom: 0;
    }

    .results-card {
        margin-bottom: 0;
        height: 100%;
        overflow: auto;
    }
</style>

@code {
    private MemoryScannerState _state = new();

    private async Task RefreshProcessList()
    {
        Logger.LogInformation("Starting process list refresh");
        _state.IsLoading = true;
        StateHasChanged();
        
        try
        {
            Logger.LogDebug("Calling ScannerService.RefreshProcessList");
            await ScannerService.RefreshProcessList(_state);
            Logger.LogInformation("Process list refreshed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh process list");
            throw;
        }
        finally
        {
            _state.IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnProcessSelected()
    {
        try
        {
            Logger.LogInformation("Process selected: ID {ProcessId}", _state.SelectedProcessId);
            await ScannerService.OnProcessSelected(_state);
            Logger.LogDebug("Process selection handled successfully");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling process selection for ID {ProcessId}", _state.SelectedProcessId);
            throw;
        }
    }

    private async Task OnScanTypeChanged(ScanType newType)
    {
        try
        {
            Logger.LogInformation("Scan type changing from {OldType} to {NewType}",
                _state.SelectedScanType, newType);
            await ScannerService.OnScanTypeChanged(_state, newType);
            Logger.LogDebug("Scan type changed successfully");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing scan type to {NewType}", newType);
            throw;
        }
    }

    private void OnValueTypeChanged(MemoryValueType newType)
    {
        try
        {
            Logger.LogInformation("Value type changing from {OldType} to {NewType}",
                _state.SelectedValueType, newType);
            ScannerService.OnValueTypeChanged(_state, newType);
            Logger.LogDebug("Value type changed successfully");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing value type to {NewType}", newType);
            throw;
        }
    }

    private async Task OnScan()
    {
        if (!_state.CanScan)
        {
            Logger.LogWarning("Scan attempted but CanScan is false");
            return;
        }

        try
        {
            Logger.LogInformation("Starting memory scan");
            await scanExecutor.ExecuteScan(valueHandler.GetCurrentValue);
            Logger.LogDebug("Scan execution initiated successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing memory scan");
            throw;
        }
    }

    private void OnScanComplete(List<IntPtr> results)
    {
        try
        {
            Logger.LogInformation("Scan completed with {Count} results", results.Count);
            _state.OnScanComplete(results);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error handling scan completion");
            throw;
        }
    }

    private void OnLoadingChanged(bool loading)
    {
        Logger.LogDebug("Loading state changed to {Loading}", loading);
        _state.IsLoading = loading;
        StateHasChanged();
    }

    private int GetCurrentValue(IntPtr address)
    {
        try
        {
            var value = valueHandler.GetCurrentValue(address);
            Logger.LogTrace("Retrieved current value {Value} from address {Address}", value, address);
            return value;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error getting current value from address {Address}", address);
            throw;
        }
    }

    private async Task OnValueChanged((IntPtr address, int value) change)
    {
        try
        {
            Logger.LogDebug("Value change requested: Address {Address}, New Value {Value}",
                change.address, change.value);
            await valueHandler.OnValueChanged(change);
            Logger.LogTrace("Value changed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error changing value at address {Address}", change.address);
            throw;
        }
    }

    private async Task ToggleFreeze(IntPtr address)
    {
        try
        {
            Logger.LogDebug("Toggle freeze requested for address {Address}", address);
            await valueFreezer.ToggleFreeze(address, GetCurrentValue(address));
            Logger.LogTrace("Freeze toggle completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error toggling freeze for address {Address}", address);
            throw;
        }
    }

    private bool IsFrozen(IntPtr address)
    {
        try
        {
            var frozen = valueFreezer.IsFrozen(address);
            Logger.LogTrace("Checked freeze status for address {Address}: {IsFrozen}", address, frozen);
            return frozen;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error checking freeze status for address {Address}", address);
            throw;
        }
    }

    private async Task SaveConfig()
    {
        try
        {
            Logger.LogInformation("Starting configuration save");
            var config = _state.ToConfig();
            var result = await DialogService.OpenAsync<SaveConfigDialog>("Save Configuration");
            
            if (result is string configName && !string.IsNullOrEmpty(configName))
            {
                Logger.LogDebug("Saving configuration with name: {ConfigName}", configName);
                await ProfileService.SaveScannerConfig(configName, config);
                NotificationService.ShowSuccess("Success", "Configuration saved successfully");
                Logger.LogInformation("Configuration saved successfully: {ConfigName}", configName);
            }
            else
            {
                Logger.LogDebug("Configuration save cancelled or invalid name provided");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save configuration");
            NotificationService.ShowError("Error", "Failed to save configuration", ex);
        }
    }

    private async Task LoadConfig()
    {
        try
        {
            Logger.LogInformation("Starting configuration load");
            var configs = await ProfileService.GetScannerConfigs();
            Logger.LogDebug("Retrieved {Count} configurations", configs.Count);
            
            var result = await DialogService.OpenAsync<LoadConfigDialog>("Load Configuration",
                new Dictionary<string, object> { { "Configs", configs } });
            
            if (result is ScannerConfig config)
            {
                Logger.LogDebug("Loading selected configuration");
                _state.LoadConfig(config);
                NotificationService.ShowSuccess("Success", "Configuration loaded successfully");
                Logger.LogInformation("Configuration loaded successfully");
                StateHasChanged();
            }
            else
            {
                Logger.LogDebug("Configuration load cancelled");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load configuration");
            NotificationService.ShowError("Error", "Failed to load configuration", ex);
        }
    }
}

@page "/memory-scanner"
@using System.Security.Principal
@using BlazorFridaApp.MemoryScanner.Components
@inherits MemoryScannerComponentBase
@implements IAsyncDisposable

@inject IProcessService ProcessService
@inject IScanProfileService ProfileService
@inject NotificationService NotificationService

<RadzenCard>
    <h2>Memory Scanner</h2>
    
    @if (!IsAdmin)
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Administrator Rights Required!</h4>
            <p>Memory scanning features are disabled because the application is not running with administrator privileges.</p>
            <hr>
            <p class="mb-0">Please restart the application as administrator to use memory scanning features.</p>
        </div>
        return;
    }
    
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <ProcessSelector 
            ProcessList="@processList"
            SelectedProcessId="@selectedProcessId"
            OnProcessSelected="@OnProcessSelected"
            OnRefreshClick="@RefreshProcessList" />

        <ScanControls 
            ScanType="@selectedScanType"
            ValueType="@selectedValueType"
            ScanTypes="@scanTypes"
            ValueTypes="@valueTypes"
            PatternHex="@patternHex"
            Mask="@mask"
            SearchValue="@searchValue"
            IsFirstScan="@isFirstScan"
            IsLoading="@isLoading"
            CanScan="@canScan"
            OnScanTypeChanged="@OnScanTypeChanged"
            OnValueTypeChanged="@OnValueTypeChanged"
            OnScanClick="@OnScan" />
        
        <ScanExecutor @ref="scanExecutor"
            ProcessId="@selectedProcessId"
            ScanType="@selectedScanType"
            ValueType="@selectedValueType"
            PatternHex="@patternHex"
            Mask="@mask"
            SearchValue="@searchValue"
            IsFirstScan="@isFirstScan"
            IsLoading="@isLoading"
            OnScanComplete="@OnScanComplete"
            OnLoadingChanged="@OnLoadingChanged" />
        
        <MemoryValueHandler @ref="valueHandler"
            ValueType="@selectedValueType" />
            
        <ValueFreezer @ref="valueFreezer"
            ValueType="@selectedValueType" />
        
        <ScanResultsGrid 
            Results="@scanResults"
            ValueType="@selectedValueType"
            GetCurrentValue="@GetCurrentValue"
            IsFrozen="@IsFrozen"
            OnValueChanged="@OnValueChanged"
            OnFreezeToggle="@ToggleFreeze" />
    </RadzenStack>
</RadzenCard>

@code {
    private List<Process> processList = new();
    private int? selectedProcessId;
    private string patternHex = "";
    private string mask = "";
    private List<IntPtr> scanResults = new();
    private ScanType selectedScanType = ScanType.ExactValue;
    private MemoryValueType selectedValueType = MemoryValueType.Int;
    private int searchValue;
    private bool isFirstScan = true;
    private bool IsAdmin;
    private bool isLoading;

    private ScanExecutor scanExecutor;
    private MemoryValueHandler valueHandler;
    private ValueFreezer valueFreezer;

    private Array scanTypes = Enum.GetValues(typeof(ScanType));
    private Array valueTypes = Enum.GetValues(typeof(MemoryValueType));

    protected override void OnInitialized()
    {
        Logger.LogInformation("Initializing MemoryScanner component");
        IsAdmin = new WindowsPrincipal(WindowsIdentity.GetCurrent())
            .IsInRole(WindowsBuiltInRole.Administrator);
        Logger.LogInformation($"Admin check result: {IsAdmin}");
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdmin)
        {
            ShowWarning("Administrator rights required",
                "Please restart the application as administrator to use memory scanning features");
            return;
        }

        await RefreshProcessList();
    }

    private async Task RefreshProcessList()
    {
        try
        {
            Logger.LogInformation("Refreshing process list...");
            processList = ProcessService.GetAccessibleProcesses();
            
            if (!processList.Any())
            {
                ShowWarning("No accessible processes found",
                    "Make sure you have administrator rights and necessary permissions");
                return;
            }
            
            Logger.LogInformation($"Successfully loaded {processList.Count} processes");
            await LoadLastProcess();
        }
        catch (Exception ex)
        {
            ShowError("Failed to refresh process list",
                "Failed to load process list. Please ensure you have administrator rights.", ex);
        }
    }

    private async Task LoadLastProcess()
    {
        var lastId = await ProfileService.GetLastProcessId();
        if (lastId.HasValue)
        {
            selectedProcessId = lastId.Value;
            await OnProcessSelected();
        }
    }

    private async Task OnProcessSelected()
    {
        try
        {
            if (selectedProcessId.HasValue)
            {
                await ProfileService.SaveLastProcess(selectedProcessId.Value);
                scanResults.Clear();
                valueHandler?.ClearCache();
                isFirstScan = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ShowError("Error selecting process", ex.Message, ex);
        }
    }

    private async Task OnScanTypeChanged(ScanType newType)
    {
        try
        {
            Logger.LogInformation($"Changing scan type from {selectedScanType} to {newType}");
            selectedScanType = newType;
            scanResults.Clear();
            valueHandler?.ClearCache();
            isFirstScan = true;
            StateHasChanged();
            
            ShowInfo("Scan type changed", $"Selected scan type: {selectedScanType}");
        }
        catch (Exception ex)
        {
            ShowError("Error changing scan type", ex.Message, ex);
        }
    }

    private void OnValueTypeChanged(MemoryValueType newType)
    {
        try
        {
            Logger.LogInformation($"Changing value type from {selectedValueType} to {newType}");
            selectedValueType = newType;
            scanResults.Clear();
            valueHandler?.ClearCache();
            isFirstScan = true;
            StateHasChanged();
            
            ShowInfo("Value type changed", $"Selected value type: {selectedValueType}");
        }
        catch (Exception ex)
        {
            ShowError("Error changing value type", ex.Message, ex);
        }
    }

    private bool canScan =>
        IsAdmin &&
        selectedProcessId.HasValue &&
        selectedValueType != MemoryValueType.String && // Strings not supported yet
        selectedValueType != MemoryValueType.Array &&  // Arrays not supported yet
        (selectedScanType == ScanType.Pattern ?
            !string.IsNullOrWhiteSpace(patternHex) && !string.IsNullOrWhiteSpace(mask) :
            selectedScanType == ScanType.UnknownInitialValue ||
            (searchValue != 0 && selectedValueType != default(MemoryValueType)));

    private async Task OnScan()
    {
        if (!canScan) return;
        await scanExecutor.ExecuteScan(valueHandler.GetCurrentValue);
    }

    private void OnScanComplete(List<IntPtr> results)
    {
        scanResults = results;
        isFirstScan = false;
        StateHasChanged();
    }

    private void OnLoadingChanged(bool loading)
    {
        isLoading = loading;
        StateHasChanged();
    }

    private int GetCurrentValue(IntPtr address) => valueHandler.GetCurrentValue(address);

    private Task OnValueChanged((IntPtr address, int value) change) => 
        valueHandler.OnValueChanged(change);

    private Task ToggleFreeze(IntPtr address) => 
        valueFreezer.ToggleFreeze(address, GetCurrentValue(address));

    private bool IsFrozen(IntPtr address) => valueFreezer.IsFrozen(address);

    public async ValueTask DisposeAsync()
    {
        if (valueFreezer != null)
        {
            await valueFreezer.DisposeAsync();
        }
    }
}

@page "/memory-scanner"
@using System.Diagnostics
@using System.Runtime.InteropServices
@using System.Security.Principal
@using BlazorFridaApp.MemoryScanner
@using BlazorFridaApp.MemoryScanner.Models
@using BlazorFridaApp.Persistence
@using Radzen
@using Radzen.Blazor
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject ProcessMemoryScanner ScannerService
@inject NotificationService NotificationService
@inject AppDbContext DbContext
@inject ILogger<MemoryScanner> _logger

<RadzenCard>
    <h2>Memory Scanner</h2>
    
    @if (!IsAdmin)
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Administrator Rights Required!</h4>
            <p>Memory scanning features are disabled because the application is not running with administrator privileges.</p>
            <hr>
            <p class="mb-0">Please restart the application as administrator to use memory scanning features.</p>
        </div>
        return;
    }
    
    <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenDropDown @bind-Value="@selectedProcessId"
                          Data="@processList"
                          TextProperty="ProcessName"
                          ValueProperty="Id"
                          Placeholder="Select process"
                          Change="@OnProcessSelected"
                          Style="width: 80%"/>
            <RadzenButton Icon="refresh"
                         Click="@RefreshProcessList"
                         ButtonStyle="ButtonStyle.Light"
                         Title="Refresh process list"/>
        </RadzenStack>
        
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
            <RadzenDropDown @bind-Value="@selectedScanType"
                          Data="@Enum.GetValues(typeof(ScanType))"
                          Change="@OnScanTypeChanged"
                          Style="width: 200px"
                          Placeholder="Scan type"/>
           <RadzenDropDown @bind-Value="@selectedValueType"
                         Data="@Enum.GetValues(typeof(MemoryValueType))"
                         Style="width: 200px"
                         Change="@OnValueTypeChanged"
                         Placeholder="Value type"/>
        </RadzenStack>
        
        @if (selectedScanType == ScanType.Pattern)
        {
            <RadzenTextArea @bind-Value="@patternHex"
                           Placeholder="Pattern (hex, space-separated)"
                           Rows="2"/>
                           
            <RadzenTextArea @bind-Value="@mask"
                           Placeholder="Mask (x - match, ? - wildcard)"
                           Rows="2"/>
        }
        else
        {
            <RadzenNumeric @bind-Value="@searchValue"
                          Placeholder="Search value"
                          Style="width: 100%"/>
                          
            @if (selectedScanType == ScanType.UnknownInitialValue)
            {
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-0">
                    Perform first scan to initialize, then change value in game and perform next scan
                </RadzenText>
            }
        }
        
        <RadzenButton Text="@(isFirstScan ? "First Scan" : "Next Scan")"
                      Click="@OnScan"
                      Disabled="@(!canScan)"
                      ButtonStyle="ButtonStyle.Primary"/>
    </RadzenStack>
    
    <RadzenDataGrid Data="@scanResults" TItem="IntPtr">
        <Columns>
            <RadzenDataGridColumn TItem="IntPtr" Title="Address" Property="@nameof(IntPtr)" FormatString="X8"/>
            <RadzenDataGridColumn TItem="IntPtr" Title="Value">
                <Template>
                    @{
                        var currentValue = GetCurrentValue(context);
                        if (selectedValueType == MemoryValueType.Float || selectedValueType == MemoryValueType.Double)
                        {
                            <RadzenNumeric TValue="double" Value="@currentValue" Format="0.00"
                                         Change="@(async (double v) => await OnValueChanged(context, (int)v))"/>
                        }
                        else
                        {
                            <div class="d-flex align-items-center">
                                <RadzenNumeric TValue="int" Value="@currentValue"
                                             Change="@(async (int v) => await OnValueChanged(context, v))"/>
                                <RadzenText TextStyle="TextStyle.Body2" class="ms-2">
                                    @FormatValue(currentValue)
                                </RadzenText>
                            </div>
                        }
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="IntPtr" Title="Actions">
                <Template>
                    <RadzenButton Icon="lock" 
                                Click="@(() => ToggleFreeze(context))" 
                                Disabled="@(IsFrozen(context))"/>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<Process> processList = new();
    private int? selectedProcessId;
    private string patternHex = "";
    private string mask = "";
    private List<IntPtr> scanResults = new();
    private HashSet<IntPtr> frozenAddresses = new();
    private Dictionary<IntPtr, int> currentValues = new();
    private Dictionary<IntPtr, int> previousValues = new();
    
    private ScanType selectedScanType = ScanType.ExactValue;
    private MemoryValueType selectedValueType = MemoryValueType.Int;
    private int searchValue;
    private bool isFirstScan = true;
    private bool IsAdmin;

    protected override void OnInitialized()
    {
        IsAdmin = new WindowsPrincipal(WindowsIdentity.GetCurrent())
            .IsInRole(WindowsBuiltInRole.Administrator);
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdmin)
        {
            NotificationService.Notify(NotificationSeverity.Warning,
                "Administrator rights required",
                "Please restart the application as administrator to use memory scanning features");
            return;
        }

        await RefreshProcessList();
    }

    private async Task RefreshProcessList()
    {
        try
        {
            _logger.LogInformation("Refreshing process list...");
            processList = ScannerService.GetProcesses();
            
            if (!processList.Any())
            {
                NotificationService.Notify(NotificationSeverity.Warning,
                    "No accessible processes found",
                    "Make sure you have administrator rights and necessary permissions");
                return;
            }
            
            _logger.LogInformation($"Successfully loaded {processList.Count} processes");
            await LoadLastProcess();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Failed to refresh process list");
            NotificationService.Notify(NotificationSeverity.Error,
                "Error loading processes",
                "Failed to load process list. Please ensure you have administrator rights.");
        }
    }

    private async Task LoadLastProcess()
    {
        var lastId = await ScannerService.GetLastProcessId();
        if (lastId.HasValue)
        {
            selectedProcessId = lastId.Value;
            await OnProcessSelected();
        }
    }

    private async Task OnProcessSelected()
    {
        try
        {
            if (selectedProcessId.HasValue)
            {
                await ScannerService.SaveLastProcess(selectedProcessId.Value);
                // Сбрасываем результаты при смене процесса
                scanResults.Clear();
                currentValues.Clear();
                previousValues.Clear();
                isFirstScan = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Error selecting process",
                ex.Message);
        }
    }

    private async Task OnScanTypeChanged()
    {
        try
        {
            isFirstScan = true;
            scanResults.Clear();
            currentValues.Clear();
            previousValues.Clear();
            StateHasChanged();
            
            NotificationService.Notify(NotificationSeverity.Info,
                "Scan type changed",
                $"Selected scan type: {selectedScanType}");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Error changing scan type",
                ex.Message);
        }
    }

    private void OnValueTypeChanged()
    {
        try
        {
            // Сбрасываем результаты при смене типа данных
            scanResults.Clear();
            currentValues.Clear();
            previousValues.Clear();
            isFirstScan = true;
            StateHasChanged();
            
            NotificationService.Notify(NotificationSeverity.Info,
                "Value type changed",
                $"Selected value type: {selectedValueType}");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Error changing value type",
                ex.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var address in frozenAddresses)
        {
            await ScannerService.UnfreezeValue(address);
        }
    }

    private bool canScan =>
        IsAdmin &&
        selectedProcessId.HasValue &&
        selectedValueType != MemoryValueType.String && // Строки пока не поддерживаются
        selectedValueType != MemoryValueType.Array &&  // Массивы пока не поддерживаются
        (selectedScanType == ScanType.Pattern ?
            !string.IsNullOrWhiteSpace(patternHex) && !string.IsNullOrWhiteSpace(mask) :
            selectedScanType == ScanType.UnknownInitialValue ||
            (searchValue != 0 && selectedValueType != default(MemoryValueType)));

    private async Task OnScan()
    {
        try
        {
            if (selectedScanType == ScanType.Pattern)
            {
                var pattern = patternHex.Split(' ')
                    .Select(b => Convert.ToByte(b, 16))
                    .ToArray();
                
                scanResults = await ScannerService.ScanForPattern(
                    selectedProcessId!.Value,
                    pattern,
                    mask);
            }
            else
            {
                if (isFirstScan)
                {
                    // First scan
                    switch (selectedScanType)
                    {
                        case ScanType.ExactValue:
                            scanResults = await ScannerService.ScanForValue(
                                selectedProcessId!.Value,
                                searchValue,
                                selectedValueType);
                            break;
                            
                        case ScanType.UnknownInitialValue:
                            scanResults = await ScannerService.GetAllAddresses(
                                selectedProcessId!.Value,
                                selectedValueType);
                            break;
                    }
                    
                    // Store current values for comparison in next scan
                    foreach (var address in scanResults)
                    {
                        var value = GetCurrentValue(address);
                        previousValues[address] = value;
                    }
                }
                else
                {
                    // Next scan
                    var newResults = new List<IntPtr>();
                    
                    foreach (var address in scanResults)
                    {
                        var currentValue = GetCurrentValue(address);
                        var previousValue = previousValues[address];
                        
                        bool keepResult = selectedScanType switch
                        {
                            ScanType.ExactValue => currentValue == searchValue,
                            ScanType.IncreasedValue => currentValue > previousValue,
                            ScanType.DecreasedValue => currentValue < previousValue,
                            ScanType.ChangedValue => currentValue != previousValue,
                            ScanType.UnchangedValue => currentValue == previousValue,
                            _ => false
                        };
                        
                        if (keepResult)
                        {
                            newResults.Add(address);
                            previousValues[address] = currentValue;
                        }
                    }
                    
                    scanResults = newResults;
                }
            }
            
            currentValues.Clear();
            isFirstScan = false;
            NotificationService.Notify(NotificationSeverity.Success,
                $"Scan completed. Found {scanResults.Count} results.");
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Scan failed", ex.Message);
        }
    }

    private int GetCurrentValue(IntPtr address)
    {
        try
        {
            if (!currentValues.TryGetValue(address, out var value))
            {
                if (selectedValueType == MemoryValueType.String || selectedValueType == MemoryValueType.Array)
                {
                    NotificationService.Notify(NotificationSeverity.Warning,
                        "Unsupported type",
                        $"Type {selectedValueType} is not supported yet");
                    return 0;
                }

                var size = selectedValueType switch
                {
                    MemoryValueType.Byte => 1,
                    MemoryValueType.Short => 2,
                    MemoryValueType.Int => 4,
                    MemoryValueType.Float => 4,
                    MemoryValueType.Long => 8,
                    MemoryValueType.Double => 8,
                    _ => throw new ArgumentException($"Unsupported value type: {selectedValueType}")
                };

                byte[] bytes;
                try
                {
                    bytes = ScannerService.ReadMemoryBytes(address, size).Result;
                }
                catch (Exception ex)
                {
                    NotificationService.Notify(NotificationSeverity.Error,
                        "Memory read error",
                        $"Failed to read memory at {address:X}: {ex.Message}");
                    return 0;
                }

                try
                {
                    value = selectedValueType switch
                    {
                        MemoryValueType.Byte => bytes[0],
                        MemoryValueType.Short => BitConverter.ToInt16(bytes),
                        MemoryValueType.Int => BitConverter.ToInt32(bytes),
                        MemoryValueType.Float => (int)BitConverter.ToSingle(bytes),
                        MemoryValueType.Long => (int)BitConverter.ToInt64(bytes),
                        MemoryValueType.Double => (int)BitConverter.ToDouble(bytes),
                        _ => throw new ArgumentException($"Unsupported value type: {selectedValueType}")
                    };
                    currentValues[address] = value;
                }
                catch (Exception ex)
                {
                    NotificationService.Notify(NotificationSeverity.Error,
                        "Value conversion error",
                        $"Failed to convert bytes to {selectedValueType}: {ex.Message}");
                    return 0;
                }
            }
            return value;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error,
                "Unexpected error",
                $"Error getting value: {ex.Message}");
            return 0;
        }
    }

    private string FormatValue(int value)
    {
        return selectedValueType switch
        {
            MemoryValueType.Float => ((float)value).ToString("F2"),
            MemoryValueType.Double => ((double)value).ToString("F2"),
            MemoryValueType.Byte => $"0x{value:X2}",
            MemoryValueType.Short => value.ToString(),
            MemoryValueType.Int => value.ToString(),
            MemoryValueType.Long => value.ToString(),
            _ => value.ToString()
        };
    }

    private async Task OnValueChanged(IntPtr address, int value)
    {
        try
        {
            var bytes = selectedValueType switch
            {
                MemoryValueType.Byte => new[] { (byte)value },
                MemoryValueType.Short => BitConverter.GetBytes((short)value),
                MemoryValueType.Int => BitConverter.GetBytes(value),
                MemoryValueType.Float => BitConverter.GetBytes((float)value),
                MemoryValueType.Long => BitConverter.GetBytes((long)value),
                MemoryValueType.Double => BitConverter.GetBytes((double)value),
                _ => BitConverter.GetBytes(value)
            };

            await ScannerService.WriteMemory(address, bytes);
            currentValues[address] = value;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to write value", ex.Message);
        }
    }

    private async Task ToggleFreeze(IntPtr address)
    {
        try
        {
            if (frozenAddresses.Contains(address))
            {
                await ScannerService.UnfreezeValue(address);
                frozenAddresses.Remove(address);
            }
            else
            {
                var value = GetCurrentValue(address);
                var bytes = selectedValueType switch
                {
                    MemoryValueType.Byte => new[] { (byte)value },
                    MemoryValueType.Short => BitConverter.GetBytes((short)value),
                    MemoryValueType.Int => BitConverter.GetBytes(value),
                    MemoryValueType.Float => BitConverter.GetBytes((float)value),
                    MemoryValueType.Long => BitConverter.GetBytes((long)value),
                    MemoryValueType.Double => BitConverter.GetBytes((double)value),
                    _ => BitConverter.GetBytes(value)
                };
                
                await ScannerService.FreezeValue(address, bytes, selectedValueType.ToString());
                frozenAddresses.Add(address);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to toggle freeze", ex.Message);
        }
    }

    private bool IsFrozen(IntPtr address) => frozenAddresses.Contains(address);
}
